index 0000000..821f4dd
--- /dev/null
+++ b/tests/coord/shallow-date-regexp.test.ts
@@ -0,0 +1,62 @@
+import { describe, expect, it } from 'vitest'
+import { shallow } from 'zustand/shallow'
+
+describe('shallow with Date values', () => {
+  it('treats two Dates with the same timestamp as equal', () => {
+    expect(shallow(new Date(1000), new Date(1000))).toBe(true)
+    expect(shallow(new Date(NaN), new Date(NaN))).toBe(true)
+  })
+
+  it('treats two Dates with different timestamps as not equal', () => {
+    expect(shallow(new Date(1000), new Date(2000))).toBe(false)
+  })
+
+  it('treats a Date and a plain object as not equal', () => {
+    expect(shallow<unknown>(new Date(1000), {})).toBe(false)
+    expect(shallow<unknown>({}, new Date(1000))).toBe(false)
+  })
+})
+
+describe('shallow with RegExp values', () => {
+  it('treats two RegExps with identical source and flags as equal', () => {
+    expect(shallow(/abc/gi, /abc/gi)).toBe(true)
+  })
+
+  it('treats RegExps differing in source as not equal', () => {
+    expect(shallow(/abc/, /abd/)).toBe(false)
+  })
+
+  it('treats RegExps differing in flags as not equal', () => {
+    expect(shallow(/abc/g, /abc/i)).toBe(false)
+  })
+})
+
+describe('existing comparison behavior is unchanged', () => {
+  it('compares plain objects exactly as before', () => {
+    expect(shallow({ a: 1, b: 2 }, { a: 1, b: 2 })).toBe(true)
+    expect(shallow({ a: 1, b: 2 }, { a: 1, b: 3 })).toBe(false)
+    expect(shallow({ a: 1 }, { a: 1, b: 2 })).toBe(false)
+  })
+
+  it('compares arrays exactly as before', () => {
+    expect(shallow([1, 2, 3], [1, 2, 3])).toBe(true)
+    expect(shallow([1, 2, 3], [1, 2, 4])).toBe(false)
+    expect(shallow([1, 2], [1, 2, 3])).toBe(false)
+  })
+
+  it('compares Maps and Sets exactly as before', () => {
+    expect(
+      shallow(new Map([['k', 1]]), new Map([['k', 1]])),
+    ).toBe(true)
+    expect(
+      shallow(new Map([['k', 1]]), new Map([['k', 2]])),
+    ).toBe(false)
+    expect(shallow(new Set([1, 2]), new Set([1, 2]))).toBe(true)
+    expect(shallow(new Set([1, 2]), new Set([1, 3]))).toBe(false)
+  })
+
+  it('compares primitives exactly as before', () => {
+    expect(shallow(1, 1)).toBe(true)
+    expect(shallow('a', 'b')).toBe(false)
+  })
+})
