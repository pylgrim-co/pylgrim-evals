@@ -0,0 +1,41 @@
+import { Hono } from '../../hono'
+import { prettyJSON } from '.'
+
+describe('Pretty JSON Middleware with replacer option', () => {
+  const body = { message: 'hono', secret: 'hide-me' }
+
+  const dropSecret = (key: string, value: unknown) =>
+    key === 'secret' ? undefined : value
+
+  const upper = (_key: string, value: unknown) =>
+    typeof value === 'string' ? value.toUpperCase() : value
+
+  const makeApp = (replacer?: (key: string, value: unknown) => unknown) => {
+    const app = new Hono()
+    app.use('*', prettyJSON(replacer ? { replacer } : undefined))
+    app.get('/', (c) => c.json(body))
+    return app
+  }
+
+  it('Should drop replaced keys while keeping indentation', async () => {
+    const res = await makeApp(dropSecret).request('/?pretty')
+    expect(await res.text()).toBe(JSON.stringify({ message: 'hono' }, null, 2))
+  })
+
+  it('Should pass the original body through without the query trigger', async () => {
+    const res = await makeApp(dropSecret).request('/')
+    expect(await res.text()).toBe(JSON.stringify(body))
+  })
+
+  it('Should apply value-transforming replacers to prettified output', async () => {
+    const res = await makeApp(upper).request('/?pretty')
+    expect(await res.text()).toBe(
+      JSON.stringify({ message: 'HONO', secret: 'HIDE-ME' }, null, 2)
+    )
+  })
+
+  it('Should match today's output without a replacer', async () => {
+    const res = await makeApp().request('/?pretty')
+    expect(await res.text()).toBe(JSON.stringify(body, null, 2))
+  })
+})
