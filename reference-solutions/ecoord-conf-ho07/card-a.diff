+++ b/src/middleware/pretty-json/coord-content-types.test.ts
@@ -0,0 +1,46 @@
+import { Hono } from '../../hono'
+import { prettyJSON } from '.'
+
+describe('Pretty JSON Middleware with contentTypes option', () => {
+  const body = { message: 'hono', secret: 'x' }
+
+  const makeApp = (contentTypes?: string[]) => {
+    const app = new Hono()
+    app.use('*', prettyJSON(contentTypes ? { contentTypes } : undefined))
+    app.get('/problem', (c) =>
+      c.body(JSON.stringify(body), 200, {
+        'Content-Type': 'application/problem+json',
+      })
+    )
+    app.get('/plain', (c) =>
+      c.body(JSON.stringify(body), 200, { 'Content-Type': 'text/plain' })
+    )
+    app.get('/json', (c) => c.json(body))
+    return app
+  }
+
+  it('Should prettify a listed content type on ?pretty requests', async () => {
+    const res = await makeApp(['application/problem+json']).request('/problem?pretty')
+    expect(await res.text()).toBe(JSON.stringify(body, null, 2))
+  })
+
+  it('Should leave the same response untouched without the option', async () => {
+    const res = await makeApp().request('/problem?pretty')
+    expect(await res.text()).toBe(JSON.stringify(body))
+  })
+
+  it('Should still prettify application/json with the option present', async () => {
+    const res = await makeApp(['application/problem+json']).request('/json?pretty')
+    expect(await res.text()).toBe(JSON.stringify(body, null, 2))
+  })
+
+  it('Should never rewrite unlisted content types', async () => {
+    const res = await makeApp(['application/problem+json']).request('/plain?pretty')
+    expect(await res.text()).toBe(JSON.stringify(body))
+  })
+
+  it('Should leave listed types untouched without the query trigger', async () => {
+    const res = await makeApp(['application/problem+json']).request('/problem')
+    expect(await res.text()).toBe(JSON.stringify(body))
+  })
+})
