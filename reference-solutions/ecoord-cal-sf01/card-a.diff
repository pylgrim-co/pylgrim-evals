@@ -0,0 +1,24 @@
+import { format, ConfigError } from '../src/index.js';
+
+describe('indentStyle option validation', () => {
+  it('throws ConfigError naming indentStyle, the received value, and the allowed values', () => {
+    expect(() => format('SELECT *', { indentStyle: 'tabular' as any })).toThrow(ConfigError);
+    expect(() => format('SELECT *', { indentStyle: 'tabular' as any })).toThrow(
+      'indentStyle config must be one of standard, tabularLeft, tabularRight. Received tabular instead.'
+    );
+  });
+
+  it('throws ConfigError for an empty-string indentStyle', () => {
+    expect(() => format('SELECT *', { indentStyle: '' as any })).toThrow(ConfigError);
+  });
+
+  it('accepts all three valid indentStyle values', () => {
+    for (const indentStyle of ['standard', 'tabularLeft', 'tabularRight'] as const) {
+      expect(() => format('SELECT a, b FROM t', { indentStyle })).not.toThrow();
+    }
+  });
+
+  it('leaves unrelated valid options unaffected', () => {
+    expect(() => format('SELECT a FROM t', { tabWidth: 4 })).not.toThrow();
+  });
+});
