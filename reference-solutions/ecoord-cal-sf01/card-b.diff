@@ -0,0 +1,28 @@
+import { format, ConfigError } from '../src/index.js';
+
+describe('logicalOperatorNewline option validation', () => {
+  it('throws ConfigError naming the option, the received value, and the allowed values', () => {
+    expect(() => format('SELECT *', { logicalOperatorNewline: 'above' as any })).toThrow(
+      ConfigError
+    );
+    expect(() => format('SELECT *', { logicalOperatorNewline: 'above' as any })).toThrow(
+      'logicalOperatorNewline config must be one of before, after. Received above instead.'
+    );
+  });
+
+  it('throws ConfigError for an empty-string logicalOperatorNewline', () => {
+    expect(() => format('SELECT *', { logicalOperatorNewline: '' as any })).toThrow(ConfigError);
+  });
+
+  it('accepts both valid logicalOperatorNewline values', () => {
+    for (const logicalOperatorNewline of ['before', 'after'] as const) {
+      expect(() =>
+        format('SELECT a FROM t WHERE x = 1 AND y = 2', { logicalOperatorNewline })
+      ).not.toThrow();
+    }
+  });
+
+  it('leaves unrelated valid options unaffected', () => {
+    expect(() => format('SELECT a FROM t', { tabWidth: 4 })).not.toThrow();
+  });
+});
