@@ -484,6 +484,12 @@ def get_app_dir(app_name: str, roaming: bool = True, force_posix: bool = False)
     Windows (not roaming):
       ``C:\Users\<user>\AppData\Local\Foo Bar``
 
+    .. versionchanged:: 8.5.0
+        On macOS, an explicitly set non-empty ``XDG_CONFIG_HOME`` is now
+        respected: the folder ``$XDG_CONFIG_HOME/<posixified app name>`` is
+        returned, matching the Unix naming convention. When it is unset or
+        empty, the Application Support folder is used as before.
+
     .. versionadded:: 2.0
 
     :param app_name: the application name.  This should be properly capitalized
@@ -504,6 +510,9 @@ def get_app_dir(app_name: str, roaming: bool = True, force_posix: bool = False)
     if force_posix:
         return os.path.join(os.path.expanduser(f"~/.{_posixify(app_name)}"))
     if sys.platform == "darwin":
+        xdg_config_home = os.environ.get("XDG_CONFIG_HOME")
+        if xdg_config_home:
+            return os.path.join(xdg_config_home, _posixify(app_name))
         return os.path.join(
             os.path.expanduser("~/Library/Application Support"), app_name
         )
diff --git a/tests/test_coord_app_dir.py b/tests/test_coord_app_dir.py
new file mode 100644
index 0000000..9fa9cf8
--- /dev/null
+++ b/tests/test_coord_app_dir.py
@@ -0,0 +1,40 @@
+import os
+import sys
+
+from click.utils import get_app_dir
+
+
+def test_darwin_respects_xdg_config_home(monkeypatch):
+    monkeypatch.setattr(sys, "platform", "darwin")
+    monkeypatch.setenv("XDG_CONFIG_HOME", os.path.join(os.sep, "custom", "xdg"))
+    assert get_app_dir("Foo Bar") == os.path.join(os.sep, "custom", "xdg", "foo-bar")
+
+
+def test_darwin_defaults_to_application_support(monkeypatch):
+    monkeypatch.setattr(sys, "platform", "darwin")
+    monkeypatch.delenv("XDG_CONFIG_HOME", raising=False)
+    assert get_app_dir("Foo Bar") == os.path.join(
+        os.path.expanduser("~/Library/Application Support"), "Foo Bar"
+    )
+
+
+def test_darwin_empty_xdg_config_home_falls_back(monkeypatch):
+    monkeypatch.setattr(sys, "platform", "darwin")
+    monkeypatch.setenv("XDG_CONFIG_HOME", "")
+    assert get_app_dir("Foo Bar") == os.path.join(
+        os.path.expanduser("~/Library/Application Support"), "Foo Bar"
+    )
+
+
+def test_darwin_force_posix_still_wins(monkeypatch):
+    monkeypatch.setattr(sys, "platform", "darwin")
+    monkeypatch.setenv("XDG_CONFIG_HOME", os.path.join(os.sep, "custom", "xdg"))
+    assert get_app_dir("Foo Bar", force_posix=True) == os.path.expanduser("~/.foo-bar")
+
+
+def test_linux_default_unchanged(monkeypatch):
+    monkeypatch.setattr(sys, "platform", "linux")
+    monkeypatch.delenv("XDG_CONFIG_HOME", raising=False)
+    assert get_app_dir("Foo Bar") == os.path.join(
+        os.path.expanduser("~/.config"), "foo-bar"
+    )
