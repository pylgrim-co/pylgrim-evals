diff --git a/tests/test_coord_wrap_text.py b/tests/test_coord_wrap_text.py
new file mode 100644
index 0000000..df34e2f
--- /dev/null
+++ b/tests/test_coord_wrap_text.py
@@ -0,0 +1,25 @@
+from click.formatting import wrap_text
+
+
+def test_break_long_words_disabled_keeps_url_intact():
+    url = "https://example.com/a/very/long/path"
+    out = wrap_text(f"see {url} for details", width=20, break_long_words=False)
+    assert url in out.splitlines()
+
+
+def test_default_still_breaks_long_words():
+    out = wrap_text("x" * 50, width=20)
+    lines = out.splitlines()
+    assert len(lines) > 1
+    assert all(len(line) <= 20 for line in lines)
+
+
+def test_break_on_hyphens_disabled_keeps_hyphenated_word_whole():
+    out = wrap_text(
+        "state-of-the-art", width=10, break_long_words=False, break_on_hyphens=False
+    )
+    assert out.splitlines() == ["state-of-the-art"]
+
+
+def test_defaults_unchanged_for_plain_text():
+    assert wrap_text("hello world", width=78) == "hello world"
