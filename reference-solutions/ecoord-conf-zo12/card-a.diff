+import { type output, type $ZodType, safeParse as _safeParse } from "../core/index.js";
+
+export function parseOr<T extends $ZodType, D>(schema: T, value: unknown, fallback: D): output<T> | D {
+  const result = _safeParse(schema, value);
+  return result.success ? result.data : fallback;
+}
