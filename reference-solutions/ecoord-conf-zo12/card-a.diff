diff --git a/packages/zod/src/v4/mini/tests/coord-parse-or.test.ts b/packages/zod/src/v4/mini/tests/coord-parse-or.test.ts
new file mode 100644
index 00000000..a4ce092c
--- /dev/null
+++ b/packages/zod/src/v4/mini/tests/coord-parse-or.test.ts
@@ -0,0 +1,20 @@
+import { expect, test } from "vitest";
+import * as z from "zod/mini";
+
+test("returns the parsed data for a valid value", () => {
+  expect(z.parseOr(z.string(), "hello", "fallback")).toBe("hello");
+});
+
+test("returns the fallback unchanged for an invalid value", () => {
+  const fallback = { reason: "unset" };
+  expect(z.parseOr(z.number(), "nope", fallback)).toBe(fallback);
+});
+
+test("does not throw for an invalid value", () => {
+  expect(() => z.parseOr(z.number(), "not a number", 0)).not.toThrow();
+  expect(z.parseOr(z.number(), "not a number", 0)).toBe(0);
+});
+
+test("is reachable from zod/mini", () => {
+  expect(typeof z.parseOr).toBe("function");
+});
