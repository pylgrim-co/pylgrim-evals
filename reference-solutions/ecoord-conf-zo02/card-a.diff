-export function joinValues<T extends Primitive[]>(array: T, separator = "|"): string {
+export function joinValues<T extends Primitive[]>(array: T, separator = "|", maxItems?: number): string {
+  if (typeof maxItems === "number" && Number.isInteger(maxItems) && maxItems > 0 && array.length > maxItems) {
+    const shown = array
+      .slice(0, maxItems)
+      .map((val) => stringifyPrimitive(val))
+      .join(separator);
+    return `${shown}${separator}+${array.length - maxItems} more`;
+  }
   return array.map((val) => stringifyPrimitive(val)).join(separator);
 }
 
