diff --git a/packages/zod/src/v4/classic/tests/coord-hex-color.test.ts b/packages/zod/src/v4/classic/tests/coord-hex-color.test.ts
new file mode 100644
index 00000000..be602024
--- /dev/null
+++ b/packages/zod/src/v4/classic/tests/coord-hex-color.test.ts
@@ -0,0 +1,31 @@
+import { expect, test } from "vitest";
+
+import * as z from "zod/v4";
+
+test("valid CSS hex colors parse successfully", () => {
+  expect(z.hexColor().parse("#fff")).toBe("#fff");
+  expect(z.hexColor().parse("#abcd")).toBe("#abcd");
+  expect(z.hexColor().parse("#a1b2c3")).toBe("#a1b2c3");
+  expect(z.hexColor().parse("#A1B2C3")).toBe("#A1B2C3");
+  expect(z.hexColor().parse("#a1b2c3ff")).toBe("#a1b2c3ff");
+});
+
+test("invalid hex colors fail validation", () => {
+  expect(z.hexColor().safeParse("fff").success).toBe(false); // missing #
+  expect(z.hexColor().safeParse("#ggg").success).toBe(false); // bad digits
+  expect(z.hexColor().safeParse("#12345").success).toBe(false); // bad length
+  expect(z.hexColor().safeParse("").success).toBe(false);
+  expect(z.hexColor().safeParse("#fff ").success).toBe(false); // anchored at both ends
+});
+
+test("a custom error message passed as params surfaces on failure", () => {
+  const result = z.hexColor("not a hex color").safeParse("nope");
+  expect(result.success).toBe(false);
+  expect(result.error!.issues[0].message).toBe("not a hex color");
+});
+
+test("z.hexColor() is chainable", () => {
+  const schema = z.hexColor().min(4);
+  expect(schema.parse("#fff")).toBe("#fff");
+  expect(schema.parse("#a1b2c3")).toBe("#a1b2c3");
+});
