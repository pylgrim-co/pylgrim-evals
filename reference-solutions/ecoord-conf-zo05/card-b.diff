 export const sha512_hex: RegExp = /^[0-9a-fA-F]{128}$/;
 export const sha512_base64: RegExp = /*@__PURE__*/ fixedBase64(86, "==");
 export const sha512_base64url: RegExp = /*@__PURE__*/ fixedBase64url(86);
