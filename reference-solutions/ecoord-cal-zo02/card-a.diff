index 00000000..acb34d8f
--- /dev/null
+++ b/packages/zod/src/v4/classic/tests/coord-starts-with-ignore-case.test.ts
@@ -0,0 +1,31 @@
+import { expect, test } from "vitest";
+
+import * as z from "zod/v4";
+
+test("accepts the prefix in any case", () => {
+  const schema = z.string().check(z.startsWithIgnoreCase("sku-"));
+  expect(schema.parse("SKU-1")).toBe("SKU-1");
+  expect(schema.parse("sku-1")).toBe("sku-1");
+  expect(schema.parse("Sku-1")).toBe("Sku-1");
+});
+
+test("rejects strings that do not start with the prefix", () => {
+  const schema = z.string().check(z.startsWithIgnoreCase("sku-"));
+  expect(schema.safeParse("ask-1").success).toBe(false);
+  expect(schema.safeParse("xsku-1").success).toBe(false);
+});
+
+test("treats regex metacharacters in the prefix literally", () => {
+  const schema = z.string().check(z.startsWithIgnoreCase("a.b"));
+  expect(schema.parse("a.b-ok")).toBe("a.b-ok");
+  expect(schema.safeParse("axb-ok").success).toBe(false);
+});
+
+test("a custom error message passed as params surfaces on failure", () => {
+  const result = z
+    .string()
+    .check(z.startsWithIgnoreCase("sku-", "must look like a sku"))
+    .safeParse("nope");
+  expect(result.success).toBe(false);
+  expect(result.error!.issues[0].message).toBe("must look like a sku");
+});
