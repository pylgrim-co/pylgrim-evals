diff --git a/packages/zod/src/v4/classic/tests/coord-ends-with-ignore-case.test.ts b/packages/zod/src/v4/classic/tests/coord-ends-with-ignore-case.test.ts
new file mode 100644
index 00000000..7165e1bd
--- /dev/null
+++ b/packages/zod/src/v4/classic/tests/coord-ends-with-ignore-case.test.ts
@@ -0,0 +1,30 @@
+import { expect, test } from "vitest";
+
+import * as z from "zod/v4";
+
+test("accepts the suffix in any case", () => {
+  const schema = z.string().check(z.endsWithIgnoreCase(".pdf"));
+  expect(schema.parse("a.PDF")).toBe("a.PDF");
+  expect(schema.parse("a.pdf")).toBe("a.pdf");
+  expect(schema.parse("a.Pdf")).toBe("a.Pdf");
+});
+
+test("rejects strings that do not end with the suffix", () => {
+  const schema = z.string().check(z.endsWithIgnoreCase(".pdf"));
+  expect(schema.safeParse("a.pdfx").success).toBe(false);
+  expect(schema.safeParse("apdf").success).toBe(false);
+});
+
+test("treats regex metacharacters in the suffix literally", () => {
+  const schema = z.string().check(z.endsWithIgnoreCase(".pdf"));
+  expect(schema.safeParse("axpdf").success).toBe(false);
+});
+
+test("a custom error message passed as params surfaces on failure", () => {
+  const result = z
+    .string()
+    .check(z.endsWithIgnoreCase(".pdf", "must be a pdf filename"))
+    .safeParse("nope");
+  expect(result.success).toBe(false);
+  expect(result.error!.issues[0].message).toBe("must be a pdf filename");
+});
