index 0000000..2fdc6e5
--- /dev/null
+++ b/tests/test_coord_short_help_sentences.py
@@ -0,0 +1,28 @@
+import click
+from click.utils import make_default_short_help
+
+
+def test_exclamation_ends_first_sentence():
+    assert make_default_short_help("Run it! Second sentence here.") == "Run it!"
+
+
+def test_question_mark_ends_first_sentence():
+    assert make_default_short_help("Ready to go? Second sentence here.") == (
+        "Ready to go?"
+    )
+
+
+def test_period_behavior_is_unchanged():
+    assert make_default_short_help("First. Second.") == "First."
+
+
+def test_command_short_help_stops_at_exclamation():
+    cmd = click.Command(
+        "deploy", help="Deploy everything! Also does other things."
+    )
+    assert cmd.get_short_help_str() == "Deploy everything!"
+
+
+def test_long_sentence_without_terminator_still_gets_ellipsis():
+    result = make_default_short_help("word " * 20, max_length=45)
+    assert result == " ".join(["word"] * 8) + "..."
