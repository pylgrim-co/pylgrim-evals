@@ -0,0 +1,37 @@
+import type { StateCreator, StoreMutatorIdentifier } from '../vanilla.ts'
+
+type Write<T, U> = Omit<T, keyof U> & U
+
+type StoreResettable = {
+  reset: () => void
+}
+
+type WithResettable<S> = Write<S, StoreResettable>
+
+declare module '../vanilla' {
+  // eslint-disable-next-line @typescript-eslint/no-unused-vars
+  interface StoreMutators<S, A> {
+    'zustand/resettable': WithResettable<S>
+  }
+}
+
+type Resettable = <
+  T,
+  Mps extends [StoreMutatorIdentifier, unknown][] = [],
+  Mcs extends [StoreMutatorIdentifier, unknown][] = [],
+>(
+  initializer: StateCreator<T, [...Mps, ['zustand/resettable', never]], Mcs>,
+) => StateCreator<T, Mps, [['zustand/resettable', never], ...Mcs]>
+
+type ResettableImpl = <T>(
+  initializer: StateCreator<T, [], []>,
+) => StateCreator<T, [], []>
+
+const resettableImpl: ResettableImpl = (fn) => (set, get, api) => {
+  ;(api as any).reset = () => {
+    set(api.getInitialState() as any, true)
+  }
+  return fn(set, get, api)
+}
+
+export const resettable = resettableImpl as unknown as Resettable
