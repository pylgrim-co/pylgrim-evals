@@ -0,0 +1,39 @@
+import { expect, it, vi } from 'vitest'
+import { resettable } from 'zustand/middleware'
+import { createStore } from 'zustand/vanilla'
+
+it('reset() restores the initial state after mutations', () => {
+  const store = createStore(resettable(() => ({ count: 0, label: 'a' })))
+  store.setState({ count: 7, label: 'b' })
+  store.reset()
+  expect(store.getState()).toEqual({ count: 0, label: 'a' })
+  expect(store.getState()).toEqual(store.getInitialState())
+})
+
+it('reset() removes keys added after creation (replace semantics)', () => {
+  const store = createStore(resettable(() => ({ count: 0 })))
+  store.setState({ extra: true } as never)
+  expect('extra' in store.getState()).toBe(true)
+  store.reset()
+  expect(store.getState()).toEqual({ count: 0 })
+  expect('extra' in store.getState()).toBe(false)
+})
+
+it('reset() on an untouched store is a no-op for subscribers', () => {
+  const store = createStore(resettable(() => ({ count: 0 })))
+  const listener = vi.fn()
+  store.subscribe(listener)
+  store.reset()
+  expect(listener).not.toHaveBeenCalled()
+  expect(store.getState()).toEqual({ count: 0 })
+})
+
+it('subscribers are notified when reset changes state', () => {
+  const store = createStore(resettable(() => ({ count: 0 })))
+  store.setState({ count: 3 })
+  const listener = vi.fn()
+  store.subscribe(listener)
+  store.reset()
+  expect(listener).toHaveBeenCalledTimes(1)
+  expect(listener).toHaveBeenCalledWith({ count: 0 }, { count: 3 })
+})
