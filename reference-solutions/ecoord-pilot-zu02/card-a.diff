+import { afterAll, afterEach, expect, it, vi } from 'vitest'
+import { logger } from 'zustand/middleware'
+import { createStore } from 'zustand/vanilla'
+
+const logSpy = vi.spyOn(console, 'log').mockImplementation(() => {})
+
+afterEach(() => {
+  logSpy.mockClear()
+})
+
+afterAll(() => {
+  logSpy.mockRestore()
+})
+
+it('logs the new state after setState', () => {
+  const store = createStore(logger(() => ({ count: 0 })))
+  store.setState({ count: 1 })
+  expect(logSpy).toHaveBeenCalledTimes(1)
+  expect(logSpy).toHaveBeenLastCalledWith('new state', { count: 1 })
+})
+
+it('prefixes the log with the provided name', () => {
+  const store = createStore(logger(() => ({ count: 0 }), 'counter'))
+  store.setState({ count: 2 })
+  expect(logSpy).toHaveBeenLastCalledWith('[counter] new state', { count: 2 })
+})
+
+it('logs when set is called from inside the initializer actions', () => {
+  const store = createStore(
+    logger((set) => ({
+      count: 0,
+      inc: () => set((state) => ({ count: state.count + 1 })),
+    })),
+  )
+  store.getState().inc()
+  expect(logSpy).toHaveBeenCalledTimes(1)
+  expect(store.getState().count).toBe(1)
+})
+
+it('state updates behave normally', () => {
+  const store = createStore(logger(() => ({ count: 0 })))
+  store.setState({ count: 5 })
+  expect(store.getState()).toEqual({ count: 5 })
+})
