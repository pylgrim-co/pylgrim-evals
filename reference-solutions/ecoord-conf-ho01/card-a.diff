@@ -0,0 +1,38 @@
+import { Hono } from '../../hono'
+import { timeout } from '.'
+
+describe('Timeout Middleware Duration Guard', () => {
+  it('Should throw a TypeError for NaN', () => {
+    expect(() => timeout(NaN)).toThrow(TypeError)
+  })
+
+  it('Should throw a TypeError for a negative duration', () => {
+    expect(() => timeout(-100)).toThrow(TypeError)
+  })
+
+  it('Should throw a TypeError for Infinity', () => {
+    expect(() => timeout(Infinity)).toThrow(TypeError)
+  })
+
+  it('Should throw a TypeError for a non-number duration', () => {
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    expect(() => timeout('5000' as any)).toThrow(TypeError)
+  })
+
+  it('Should name the middleware and the requirement in the message', () => {
+    expect(() => timeout(NaN)).toThrow(
+      /timeout middleware.*positive finite number of milliseconds/
+    )
+  })
+
+  it('Should not throw per request and still respond 200 for a valid duration', async () => {
+    const app = new Hono()
+    app.use('/fast-endpoint', timeout(1000))
+    app.get('/fast-endpoint', (c) => c.text('Completed within time limit'))
+
+    const res = await app.request('http://localhost/fast-endpoint')
+    expect(res).not.toBeNull()
+    expect(res.status).toBe(200)
+    expect(await res.text()).toBe('Completed within time limit')
+  })
+})
