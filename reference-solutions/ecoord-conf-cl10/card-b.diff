index 0000000..c7846e1
--- /dev/null
+++ b/tests/test_coord_nushell_completion.py
@@ -0,0 +1,42 @@
+import click
+from click.shell_completion import (
+    BashComplete,
+    CompletionItem,
+    FishComplete,
+    NushellComplete,
+    ZshComplete,
+    get_completion_class,
+)
+
+
+def _make(prog_name="mycli"):
+    cli = click.Command("mycli", params=[click.Option(["--name"])])
+    return NushellComplete(cli, {}, prog_name, "_MYCLI_COMPLETE")
+
+
+def test_nushell_is_registered():
+    cls = get_completion_class("nushell")
+    assert cls is NushellComplete
+    assert cls.name == "nushell"
+
+
+def test_source_renders_prog_and_complete_var():
+    complete = _make()
+    source = complete.source()
+    assert "mycli" in source
+    assert "_MYCLI_COMPLETE" in source
+    assert "nushell_complete" in source
+
+
+def test_format_completion_shapes():
+    complete = _make()
+    plain = CompletionItem("value")
+    assert complete.format_completion(plain) == "value"
+    described = CompletionItem("value", help="does a thing")
+    assert complete.format_completion(described) == "value\tdoes a thing"
+
+
+def test_existing_shells_still_resolve():
+    assert get_completion_class("bash") is BashComplete
+    assert get_completion_class("zsh") is ZshComplete
+    assert get_completion_class("fish") is FishComplete
