@@ -207,6 +207,23 @@ complete --no-files --command %(prog_name)s --arguments \
 """
 
 
+_SOURCE_NUSHELL = """\
+def "%(complete_func)s" [spans: list<string>] {
+    with-env {
+        %(complete_var)s: "nushell_complete",
+        COMP_WORDS: ($spans | str join " "),
+    } {
+        %(prog_name)s | lines | each { |line| $line | split row "\t" | first }
+    }
+}
+
+$env.config.completions.external = {
+    enable: true
+    completer: { |spans| %(complete_func)s $spans }
+}
+"""
+
+
 class _SourceVarsDict(t.TypedDict):
     complete_func: str
     complete_var: str
@@ -456,10 +473,37 @@ class FishComplete(ShellComplete):
         return f"{item.type},{item.value}"
 
 
+class NushellComplete(ShellComplete):
+    """Shell completion for Nushell."""
+
+    name: t.ClassVar[str] = "nushell"
+    source_template: t.ClassVar[str] = _SOURCE_NUSHELL
+
+    def get_completion_args(self) -> tuple[list[str], str]:
+        cwords = split_arg_string(os.environ["COMP_WORDS"])
+        args = cwords[1:]
+
+        # Nushell passes the full span list; the last span is the
+        # (possibly empty) word being completed.
+        if args:
+            incomplete = args.pop()
+        else:
+            incomplete = ""
+
+        return args, incomplete
+
+    def format_completion(self, item: CompletionItem[str]) -> str:
+        if item.help:
+            return f"{item.value}\t{item.help}"
+
+        return item.value
+
+
 _available_shells: t.Final[dict[str, type[ShellComplete]]] = {
     "bash": BashComplete,
     "fish": FishComplete,
     "zsh": ZshComplete,
+    "nushell": NushellComplete,
 }
 
 _ShellCompleteT = t.TypeVar("_ShellCompleteT", bound="ShellComplete")
diff --git a/tests/test_coord_nushell_completion.py b/tests/test_coord_nushell_completion.py
