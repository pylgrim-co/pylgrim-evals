+import dedent from 'dedent-js';
+
+import { format as originalFormat, FormatFn } from '../src/sqlFormatter.js';
+
+describe('bigquery json constructor and lax accessor functions', () => {
+  const format: FormatFn = (query, cfg = {}) =>
+    originalFormat(query, { ...cfg, language: 'bigquery' });
+
+  it('uppercases parse_json, json_array and lax_string with functionCase: "upper"', () => {
+    const result = format('SELECT parse_json(a), json_array(b), lax_string(c) FROM t', {
+      functionCase: 'upper',
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        PARSE_JSON(a),
+        JSON_ARRAY(b),
+        LAX_STRING(c)
+      FROM
+        t
+    `);
+  });
+
+  it('lowercases TO_JSON, JSON_OBJECT and LAX_INT64 with functionCase: "lower"', () => {
+    const result = format('SELECT TO_JSON(a), JSON_OBJECT(b), LAX_INT64(c) FROM t', {
+      functionCase: 'lower',
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        to_json(a),
+        json_object(b),
+        lax_int64(c)
+      FROM
+        t
+    `);
+  });
+
+  it('still uppercases the existing array_concat function', () => {
+    const result = format('SELECT array_concat(a, b) FROM t', { functionCase: 'upper' });
+    expect(result).toBe(dedent`
+      SELECT
+        ARRAY_CONCAT(a, b)
+      FROM
+        t
+    `);
+  });
+
+  it('leaves unrelated identifiers untouched by functionCase', () => {
+    const result = format('SELECT my_column FROM t', { functionCase: 'upper' });
+    expect(result).toBe(dedent`
+      SELECT
+        my_column
+      FROM
+        t
+    `);
+  });
+});
