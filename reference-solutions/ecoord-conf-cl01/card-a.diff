+    """Removes the top level from the stack.
+
+    :raises RuntimeError: if there is no active click context to pop,
+        instead of the :exc:`AttributeError` or :exc:`IndexError` that
+        used to leak from the internal stack.
+    """
+    stack = getattr(_local, "stack", None)
+
+    if not stack:
+        raise RuntimeError("There is no active click context to pop.")
+
+    stack.pop()
 
 
