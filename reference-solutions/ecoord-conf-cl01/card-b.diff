index 0000000..c30e709
--- /dev/null
+++ b/tests/test_coord_empty_dl.py
@@ -0,0 +1,38 @@
+import pytest
+
+from click.formatting import HelpFormatter
+
+
+def test_empty_list_is_a_no_op():
+    formatter = HelpFormatter()
+    formatter.write_dl([])
+    assert formatter.getvalue() == ""
+
+
+def test_empty_list_leaves_existing_buffer_untouched():
+    formatter = HelpFormatter()
+    formatter.write("Commands:\n")
+    before = formatter.getvalue()
+    formatter.write_dl([])
+    assert formatter.getvalue() == before
+
+
+def test_empty_generator_is_a_no_op():
+    formatter = HelpFormatter()
+    formatter.write_dl(iter(()))
+    assert formatter.getvalue() == ""
+
+
+def test_two_column_rows_still_render():
+    formatter = HelpFormatter()
+    formatter.write_dl([("--verbose", "Enable verbose output.")])
+    output = formatter.getvalue()
+    assert "--verbose" in output
+    assert "Enable verbose output." in output
+
+
+def test_three_column_row_still_raises_type_error():
+    formatter = HelpFormatter()
+
+    with pytest.raises(TypeError, match="Expected two columns"):
+        formatter.write_dl([("a", "b", "c")])
