diff --git a/tests/test_coord_json_type.py b/tests/test_coord_json_type.py
new file mode 100644
index 0000000..f34528f
--- /dev/null
+++ b/tests/test_coord_json_type.py
@@ -0,0 +1,35 @@
+import pytest
+
+import click
+from click.testing import CliRunner
+
+
+def test_parses_objects_and_arrays():
+    assert click.JSON.convert('{"a": 1}', None, None) == {"a": 1}
+    assert click.JSON.convert("[1, 2]", None, None) == [1, 2]
+    assert click.JSON.convert("true", None, None) is True
+
+
+def test_non_string_passthrough():
+    value = {"already": "parsed"}
+    assert click.JSON.convert(value, None, None) is value
+
+
+def test_invalid_json_fails_with_value_in_message():
+    with pytest.raises(click.UsageError) as exc_info:
+        click.JSON.convert("{not json}", None, None)
+    assert "{not json}" in str(exc_info.value)
+
+
+def test_cli_option_parses_and_rejects():
+    @click.command()
+    @click.option("--data", type=click.JSON)
+    def cli(data):
+        click.echo(str(data["a"]))
+
+    ok = CliRunner().invoke(cli, ["--data", '{"a": 41}'])
+    assert ok.exit_code == 0
+    assert ok.output.strip() == "41"
+
+    bad = CliRunner().invoke(cli, ["--data", "{nope}"])
+    assert bad.exit_code != 0
