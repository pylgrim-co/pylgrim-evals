+class JSONParamType(ParamType[t.Any]):
+    """Parses a string value as JSON using :func:`json.loads`.
+
+    Strings are parsed and the resulting Python value is returned. Values
+    that are not strings pass through unchanged, per the :class:`ParamType`
+    contract for already-converted values. Invalid JSON fails with an error
+    naming the offending value.
+
+    Use the :data:`JSON` singleton instead of constructing this type.
+    """
+
+    name = "json"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> t.Any:
+        if not isinstance(value, str):
+            return value
+
+        try:
+            return json.loads(value)
+        except json.JSONDecodeError as e:
+            self.fail(f"{value!r} is not valid JSON: {e}", param, ctx)
+
+    def __repr__(self) -> str:
+        return "JSON"
+
+
+#: A :class:`JSONParamType` singleton, ready to use as ``type=click.JSON``.
+JSON = JSONParamType()
+
+
