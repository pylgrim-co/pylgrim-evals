+class DelimitedList(ParamType[list[str]]):
+    """Splits one string value into a list of items on a delimiter.
+
+    Useful for options like ``--tags a,b,c`` where a single value carries
+    several items. Surrounding whitespace is stripped from each item. An
+    empty string converts to an empty list. Values that are already lists
+    pass through unchanged.
+
+    :param delimiter: the string to split items on. Defaults to ``","``.
+    """
+
+    name = "delimited list"
+
+    def __init__(self, delimiter: str = ",") -> None:
+        self.delimiter = delimiter
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> list[str]:
+        if isinstance(value, list):
+            return value
+
+        value = str(value)
+
+        if not value:
+            return []
+
+        return [item.strip() for item in value.split(self.delimiter)]
+
+    def __repr__(self) -> str:
+        return f"DelimitedList({self.delimiter!r})"
+
+
