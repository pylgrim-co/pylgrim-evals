@@ -0,0 +1,30 @@
+import click
+from click.testing import CliRunner
+
+
+def test_basic_convert_strips_whitespace():
+    assert click.DelimitedList().convert("a, b,c", None, None) == ["a", "b", "c"]
+
+
+def test_empty_string_gives_empty_list():
+    assert click.DelimitedList().convert("", None, None) == []
+
+
+def test_list_passthrough():
+    value = ["x", "y"]
+    assert click.DelimitedList().convert(value, None, None) is value
+
+
+def test_custom_delimiter():
+    assert click.DelimitedList(delimiter=";").convert("a;b", None, None) == ["a", "b"]
+
+
+def test_cli_option():
+    @click.command()
+    @click.option("--tags", type=click.DelimitedList())
+    def cli(tags):
+        click.echo("|".join(tags))
+
+    result = CliRunner().invoke(cli, ["--tags", "a, b,c"])
+    assert result.exit_code == 0
+    assert result.output.strip() == "a|b|c"
