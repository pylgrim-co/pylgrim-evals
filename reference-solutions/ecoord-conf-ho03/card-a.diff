@@ -0,0 +1,47 @@
+import { Hono } from '../../hono'
+import { secureHeaders } from '.'
+
+describe('Secure Headers cacheControl option', () => {
+  it('Should set Cache-Control to "no-store, max-age=0" when enabled', async () => {
+    const app = new Hono()
+    app.use('*', secureHeaders({ cacheControl: true }))
+    app.get('/test', (c) => c.text('ok'))
+
+    const res = await app.request('/test')
+    expect(res.headers.get('Cache-Control')).toEqual('no-store, max-age=0')
+  })
+
+  it('Should use a string option value verbatim as the header value', async () => {
+    const app = new Hono()
+    app.use('*', secureHeaders({ cacheControl: 'no-cache' }))
+    app.get('/test', (c) => c.text('ok'))
+
+    const res = await app.request('/test')
+    expect(res.headers.get('Cache-Control')).toEqual('no-cache')
+  })
+
+  it('Should not set a Cache-Control header by default', async () => {
+    const app = new Hono()
+    app.use('*', secureHeaders())
+    app.get('/test', (c) => c.text('ok'))
+
+    const res = await app.request('/test')
+    expect(res.headers.get('Cache-Control')).toBeNull()
+  })
+
+  it('Should leave existing default headers such as X-Frame-Options unchanged', async () => {
+    const app = new Hono()
+    app.use('*', secureHeaders({ cacheControl: true }))
+    app.get('/test', (c) => c.text('ok'))
+
+    const res = await app.request('/test')
+    expect(res.headers.get('X-Frame-Options')).toEqual('SAMEORIGIN')
+
+    const defaultApp = new Hono()
+    defaultApp.use('*', secureHeaders())
+    defaultApp.get('/test', (c) => c.text('ok'))
+
+    const defaultRes = await defaultApp.request('/test')
+    expect(defaultRes.headers.get('X-Frame-Options')).toEqual('SAMEORIGIN')
+  })
+})
