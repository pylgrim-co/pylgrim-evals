diff --git a/src/utils/coord-mime-text-types.test.ts b/src/utils/coord-mime-text-types.test.ts
new file mode 100644
index 00000000..a161268e
--- /dev/null
+++ b/src/utils/coord-mime-text-types.test.ts
@@ -0,0 +1,27 @@
+import { getExtension, getMimeType } from './mime'
+
+describe('authoring format MIME types', () => {
+  it('resolves the new authoring extensions', () => {
+    expect(getMimeType('README.md')).toBe('text/markdown; charset=utf-8')
+    expect(getMimeType('config.yaml')).toBe('application/yaml')
+    expect(getMimeType('compose.yml')).toBe('application/yaml')
+  })
+
+  it('prefers the yaml extension for application/yaml', () => {
+    expect(getExtension('application/yaml')).toBe('yaml')
+  })
+
+  it('finds md for text/markdown through the base-type match', () => {
+    expect(getExtension('text/markdown')).toBe('md')
+  })
+
+  it('leaves existing mappings unchanged', () => {
+    expect(getMimeType('note.txt')).toBe('text/plain; charset=utf-8')
+    expect(getMimeType('page.html')).toBe('text/html; charset=utf-8')
+    expect(getMimeType('data.json')).toBe('application/json')
+  })
+
+  it('still returns undefined for unknown extensions', () => {
+    expect(getMimeType('file.unknownext')).toBeUndefined()
+  })
+})
