index 00000000..4e3efc31
--- /dev/null
+++ b/src/middleware/context-storage/coord-has-context.test.ts
@@ -0,0 +1,37 @@
+import { Hono } from '../../hono'
+import { contextStorage, getContext, hasContext, tryGetContext } from '.'
+
+describe('Context Storage Middleware hasContext()', () => {
+  it('Should return true inside a request handled by the middleware', async () => {
+    const app = new Hono()
+    app.use(contextStorage())
+    app.get('/', (c) => c.json({ has: hasContext() }))
+    const res = await app.request('/')
+    expect(await res.json()).toEqual({ has: true })
+  })
+
+  it('Should return false outside any request and never throw', () => {
+    expect(hasContext()).toBe(false)
+  })
+
+  it('Should return false when the middleware is not installed', async () => {
+    const app = new Hono()
+    app.get('/', (c) => c.json({ has: hasContext() }))
+    const res = await app.request('/')
+    expect(await res.json()).toEqual({ has: false })
+  })
+
+  it('Should leave getContext and tryGetContext working as before', async () => {
+    type Env = { Variables: { message: string } }
+    const app = new Hono<Env>()
+    app.use(contextStorage())
+    app.use(async (c, next) => {
+      c.set('message', 'hello')
+      await next()
+    })
+    app.get('/', (c) => c.text(getContext<Env>().var.message))
+    const res = await app.request('/')
+    expect(await res.text()).toBe('hello')
+    expect(tryGetContext()).toBeUndefined()
+  })
+})
