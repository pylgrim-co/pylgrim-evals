new file mode 100644
index 00000000..529db4e3
--- /dev/null
+++ b/src/middleware/request-id/coord-response-header.test.ts
@@ -0,0 +1,33 @@
+import { Hono } from '../../hono'
+import { requestId } from '.'
+
+describe('Request ID Middleware with responseHeaderName option', () => {
+  const makeApp = (options?: Parameters<typeof requestId>[0]) => {
+    const app = new Hono()
+    app.use('*', requestId(options))
+    app.get('/', (c) => c.text(c.get('requestId')))
+    return app
+  }
+
+  it('Should echo under the configured header and not under headerName', async () => {
+    const res = await makeApp({ responseHeaderName: 'X-Trace-Id' }).request('/', {
+      headers: { 'X-Request-Id': 'incoming-id' },
+    })
+    expect(res.headers.get('X-Trace-Id')).toBe('incoming-id')
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect(await res.text()).toBe('incoming-id')
+  })
+
+  it('Should suppress the echo with an empty responseHeaderName', async () => {
+    const res = await makeApp({ responseHeaderName: '' }).request('/')
+    expect(res.headers.get('X-Request-Id')).toBeNull()
+    expect((await res.text()).length).toBeGreaterThan(0)
+  })
+
+  it('Should keep echoing X-Request-Id without the option', async () => {
+    const res = await makeApp().request('/', {
+      headers: { 'X-Request-Id': 'incoming-id' },
+    })
+    expect(res.headers.get('X-Request-Id')).toBe('incoming-id')
+  })
+})
