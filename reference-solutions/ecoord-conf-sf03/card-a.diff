+import dedent from 'dedent-js';
+
+import { format as originalFormat, FormatFn } from '../src/sqlFormatter.js';
+
+describe('params fallback for missing values', () => {
+  const format: FormatFn = (query, cfg = {}) =>
+    originalFormat(query, { ...cfg, language: 'sqlite' });
+
+  it('leaves a named placeholder as-is when its key is missing from params', () => {
+    const result = format('SELECT :name, :missing FROM tbl;', {
+      params: { name: "'John'" },
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        'John',
+        :missing
+      FROM
+        tbl;
+    `);
+  });
+
+  it('leaves positional placeholders beyond the end of the params array as ?', () => {
+    const result = format('SELECT ?, ?, ? FROM tbl;', {
+      params: ['first', 'second'],
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        first,
+        second,
+        ?
+      FROM
+        tbl;
+    `);
+  });
+
+  it('keeps later positional placeholders in position when an earlier lookup misses', () => {
+    const result = format('SELECT ?, ?, ? FROM tbl;', {
+      params: ['first', undefined as unknown as string, 'third'],
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        first,
+        ?,
+        third
+      FROM
+        tbl;
+    `);
+  });
+
+  it('substitutes fully-supplied positional params exactly as before', () => {
+    const result = format('SELECT ?, ?, ? FROM tbl;', {
+      params: ['first', 'second', 'third'],
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        first,
+        second,
+        third
+      FROM
+        tbl;
+    `);
+  });
+
+  it('substitutes fully-supplied named params exactly as before', () => {
+    const result = format('SELECT * FROM tbl WHERE name = :name AND age > :age;', {
+      params: { name: "'John'", age: '10' },
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        *
+      FROM
+        tbl
+      WHERE
+        name = 'John'
+        AND age > 10;
+    `);
+  });
+
+  it('leaves all placeholders untouched when no params config is given', () => {
+    const result = format('SELECT ?, :name FROM tbl;');
+    expect(result).toBe(dedent`
+      SELECT
+        ?,
+        :name
+      FROM
+        tbl;
+    `);
+  });
+});
