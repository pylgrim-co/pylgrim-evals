--- /dev/null
+++ b/test/coord-params-warning-detail.test.ts
@@ -0,0 +1,85 @@
+import dedent from 'dedent-js';
+
+import { format as originalFormat, FormatFn } from '../src/sqlFormatter.js';
+
+describe('detailed params validation warning', () => {
+  const format: FormatFn = (query, cfg = {}) =>
+    originalFormat(query, { ...cfg, language: 'sqlite' });
+
+  let warnSpy: jest.SpyInstance;
+
+  beforeEach(() => {
+    warnSpy = jest.spyOn(console, 'warn').mockImplementation(() => {});
+  });
+
+  afterEach(() => {
+    warnSpy.mockRestore();
+  });
+
+  it('warns once, naming the offending object key and its type', () => {
+    const result = format('SELECT :name FROM tbl;', {
+      params: { name: "'John'", age: 25 as unknown as string },
+    });
+
+    expect(warnSpy).toHaveBeenCalledTimes(1);
+    const message: string = warnSpy.mock.calls[0][0];
+    expect(message).toContain('age');
+    expect(message).toContain('number');
+
+    // the query still formats successfully, with substitution
+    expect(result).toBe(dedent`
+      SELECT
+        'John'
+      FROM
+        tbl;
+    `);
+  });
+
+  it('warns naming the offending array index and its type', () => {
+    const result = format('SELECT ? FROM tbl;', {
+      params: ['first', 42 as unknown as string],
+    });
+
+    expect(warnSpy).toHaveBeenCalledTimes(1);
+    const message: string = warnSpy.mock.calls[0][0];
+    expect(message).toContain('index 1');
+    expect(message).toContain('number');
+
+    // the query still formats successfully, with substitution
+    expect(result).toBe(dedent`
+      SELECT
+        first
+      FROM
+        tbl;
+    `);
+  });
+
+  it('does not warn when all params values are strings', () => {
+    const result = format('SELECT :name FROM tbl;', {
+      params: { name: "'John'", age: '25' },
+    });
+
+    expect(warnSpy).not.toHaveBeenCalled();
+    expect(result).toBe(dedent`
+      SELECT
+        'John'
+      FROM
+        tbl;
+    `);
+  });
+
+  it('does not warn for an all-string params array', () => {
+    const result = format('SELECT ?, ? FROM tbl;', {
+      params: ['first', 'second'],
+    });
+
+    expect(warnSpy).not.toHaveBeenCalled();
+    expect(result).toBe(dedent`
+      SELECT
+        first,
+        second
+      FROM
+        tbl;
+    `);
+  });
+});
