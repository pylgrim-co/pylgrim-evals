+// Describes each non-string params value as its key (or index) and typeof
+function findNonStringParams(params: ParamItems | string[]): string[] {
+  if (params instanceof Array) {
+    return params
+      .map((value, index) => ({ value, index }))
+      .filter(({ value }) => typeof value !== 'string')
+      .map(({ value, index }) => `index ${index} (${typeof value})`);
+  }
+  return Object.entries(params)
+    .filter(([, value]) => typeof value !== 'string')
+    .map(([key, value]) => `"${key}" (${typeof value})`);
 }
 
