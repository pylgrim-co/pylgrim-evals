@@ -0,0 +1,38 @@
+import dedent from 'dedent-js';
+
+import { format as originalFormat, FormatFn } from '../src/sqlFormatter.js';
+
+describe('tidb EXCEPT and INTERSECT set operations', () => {
+  const format: FormatFn = (query, cfg = {}) =>
+    originalFormat(query, { ...cfg, language: 'tidb' });
+
+  ['EXCEPT', 'EXCEPT ALL', 'INTERSECT', 'INTERSECT DISTINCT'].forEach(op => {
+    it(`formats ${op} on its own line between the two SELECT blocks`, () => {
+      expect(format(`SELECT a FROM t1 ${op} SELECT a FROM t2;`)).toBe(dedent`
+        SELECT
+          a
+        FROM
+          t1
+        ${op}
+        SELECT
+          a
+        FROM
+          t2;
+      `);
+    });
+  });
+
+  it('still formats UNION ALL exactly as before', () => {
+    expect(format('SELECT a FROM t1 UNION ALL SELECT a FROM t2;')).toBe(dedent`
+      SELECT
+        a
+      FROM
+        t1
+      UNION ALL
+      SELECT
+        a
+      FROM
+        t2;
+    `);
+  });
+});
