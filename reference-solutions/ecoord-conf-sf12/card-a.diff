+import dedent from 'dedent-js';
+
+import { format as originalFormat, FormatFn } from '../src/sqlFormatter.js';
+
+describe('singlestoredb vector arithmetic functions', () => {
+  const format: FormatFn = (query, cfg = {}) =>
+    originalFormat(query, { ...cfg, language: 'singlestoredb' });
+
+  it('uppercases vector_mul and scalar_vector_mul with functionCase: "upper"', () => {
+    const result = format('SELECT vector_mul(a, b), scalar_vector_mul(s, v) FROM t', {
+      functionCase: 'upper',
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        VECTOR_MUL(a, b),
+        SCALAR_VECTOR_MUL(s, v)
+      FROM
+        t
+    `);
+  });
+
+  it('lowercases VECTOR_ELEMENTS_SUM with functionCase: "lower"', () => {
+    const result = format('SELECT VECTOR_ELEMENTS_SUM(v) FROM t', {
+      functionCase: 'lower',
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        vector_elements_sum(v)
+      FROM
+        t
+    `);
+  });
+
+  it('still uppercases the existing vector_sub function', () => {
+    const result = format('SELECT vector_sub(a, b) FROM t', { functionCase: 'upper' });
+    expect(result).toBe(dedent`
+      SELECT
+        VECTOR_SUB(a, b)
+      FROM
+        t
+    `);
+  });
+
+  it('leaves unrelated identifiers untouched by functionCase', () => {
+    const result = format('SELECT my_column FROM t', { functionCase: 'upper' });
+    expect(result).toBe(dedent`
+      SELECT
+        my_column
+      FROM
+        t
+    `);
+  });
+});
