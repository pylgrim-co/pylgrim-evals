diff --git a/packages/zod/src/v4/classic/tests/coord-string-squish.test.ts b/packages/zod/src/v4/classic/tests/coord-string-squish.test.ts
new file mode 100644
index 00000000..5a375a7b
--- /dev/null
+++ b/packages/zod/src/v4/classic/tests/coord-string-squish.test.ts
@@ -0,0 +1,30 @@
+import { expect, test } from "vitest";
+
+import * as z from "zod/v4";
+
+test("squish trims the ends and collapses inner runs of spaces", () => {
+  expect(z.string().squish().parse("  hello   world  ")).toBe("hello world");
+});
+
+test("tabs and newlines inside the string collapse to single spaces", () => {
+  expect(z.string().squish().parse("hello\t\tworld")).toBe("hello world");
+  expect(z.string().squish().parse("hello\n\nworld")).toBe("hello world");
+  expect(z.string().squish().parse("\t hello \n\t world \n")).toBe("hello world");
+});
+
+test("an already-clean string is returned unchanged", () => {
+  expect(z.string().squish().parse("hello world")).toBe("hello world");
+  expect(z.string().squish().parse("hello")).toBe("hello");
+});
+
+test("an all-whitespace string squishes to the empty string", () => {
+  expect(z.string().squish().parse("   ")).toBe("");
+  expect(z.string().squish().parse("\t\n ")).toBe("");
+  expect(z.string().squish().parse("")).toBe("");
+});
+
+test("squish chains with other string methods", () => {
+  const schema = z.string().squish().min(1);
+  expect(schema.safeParse("   ").success).toBe(false);
+  expect(schema.parse(" a ")).toBe("a");
+});
