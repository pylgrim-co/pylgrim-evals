--- /dev/null
+++ b/packages/zod/src/v4/classic/tests/coord-number-clamp.test.ts
@@ -0,0 +1,35 @@
+import { expect, test } from "vitest";
+
+import * as z from "zod/v4";
+
+test("clamp pins values into the closed range", () => {
+  const schema = z.number().clamp(0, 10);
+  expect(schema.parse(-5)).toBe(0);
+  expect(schema.parse(42)).toBe(10);
+  expect(schema.parse(7)).toBe(7);
+});
+
+test("boundary values pass through unchanged", () => {
+  const schema = z.number().clamp(0, 10);
+  expect(schema.parse(0)).toBe(0);
+  expect(schema.parse(10)).toBe(10);
+});
+
+test("non-numeric input is still rejected as an invalid-type failure", () => {
+  const schema = z.number().clamp(0, 10);
+  const result = schema.safeParse("5");
+  expect(result.success).toBe(false);
+  expect(result.error!.issues[0].code).toBe("invalid_type");
+});
+
+test("clamp chains with other number methods", () => {
+  const schema = z.number().clamp(0, 10).int();
+  expect(schema.parse(3)).toBe(3);
+  expect(schema.parse(99)).toBe(10);
+});
+
+test("invalid bounds throw TypeError at construction", () => {
+  expect(() => z.number().clamp(10, 0)).toThrow(TypeError);
+  expect(() => z.number().clamp(Number.NaN, 5)).toThrow(TypeError);
+  expect(() => z.number().clamp(5, Number.NaN)).toThrow(TypeError);
+});
