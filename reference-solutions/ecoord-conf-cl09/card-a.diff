@@ -0,0 +1,39 @@
+import click
+from click.testing import CliRunner
+
+
+@click.command()
+def ok_cli():
+    click.echo("fine")
+
+
+@click.command()
+def boom_cli():
+    raise ValueError("boom")
+
+
+@click.command()
+def exit_cli():
+    ctx = click.get_current_context()
+    ctx.exit(2)
+
+
+def test_ok_true_on_success():
+    result = CliRunner().invoke(ok_cli)
+    assert result.ok is True
+
+
+def test_ok_false_on_captured_exception():
+    result = CliRunner().invoke(boom_cli)
+    assert result.exit_code == 1
+    assert result.ok is False
+
+
+def test_ok_false_on_nonzero_exit():
+    result = CliRunner().invoke(exit_cli)
+    assert result.exit_code == 2
+    assert result.ok is False
+
+
+def test_ok_is_bool():
+    assert isinstance(CliRunner().invoke(ok_cli).ok, bool)
