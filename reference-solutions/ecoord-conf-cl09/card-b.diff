         exc_str = repr(self.exception) if self.exception else "okay"
         return f"<{type(self).__name__} {exc_str}>"
 
+    def raise_on_error(self) -> None:
+        """Re-raise the exception captured by :meth:`CliRunner.invoke`,
+        with its original traceback when available. Does nothing when the
+        invocation did not capture an exception.
+        """
+        if self.exception is None:
+            return
+
+        if self.exc_info is not None:
+            raise self.exception.with_traceback(self.exc_info[2])
+
+        raise self.exception
+
 
