diff --git a/packages/zod/src/v4/classic/tests/coord-slug-format.test.ts b/packages/zod/src/v4/classic/tests/coord-slug-format.test.ts
new file mode 100644
index 00000000..947dd3fb
--- /dev/null
+++ b/packages/zod/src/v4/classic/tests/coord-slug-format.test.ts
@@ -0,0 +1,31 @@
+import { expect, test } from "vitest";
+
+import * as z from "zod/v4";
+
+test("valid slugs parse successfully", () => {
+  expect(z.slug().parse("hello")).toBe("hello");
+  expect(z.slug().parse("hello-world")).toBe("hello-world");
+  expect(z.slug().parse("a-1-b-2")).toBe("a-1-b-2");
+  expect(z.slug().parse("2024-review")).toBe("2024-review");
+});
+
+test("invalid slugs fail validation", () => {
+  expect(z.slug().safeParse("Hello-World").success).toBe(false); // uppercase
+  expect(z.slug().safeParse("hello world").success).toBe(false); // space
+  expect(z.slug().safeParse("-hello").success).toBe(false); // leading hyphen
+  expect(z.slug().safeParse("hello-").success).toBe(false); // trailing hyphen
+  expect(z.slug().safeParse("hello--world").success).toBe(false); // doubled hyphen
+  expect(z.slug().safeParse("").success).toBe(false);
+});
+
+test("a custom error message passed as params surfaces on failure", () => {
+  const result = z.slug("not a slug").safeParse("NOPE");
+  expect(result.success).toBe(false);
+  expect(result.error!.issues[0].message).toBe("not a slug");
+});
+
+test("z.slug() is chainable", () => {
+  const schema = z.slug().min(3);
+  expect(schema.parse("hello-world")).toBe("hello-world");
+  expect(schema.safeParse("ab").success).toBe(false); // too short
+});
