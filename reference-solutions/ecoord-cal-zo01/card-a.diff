diff --git a/packages/zod/src/v4/classic/tests/coord-semver-format.test.ts b/packages/zod/src/v4/classic/tests/coord-semver-format.test.ts
new file mode 100644
index 00000000..43bb331f
--- /dev/null
+++ b/packages/zod/src/v4/classic/tests/coord-semver-format.test.ts
@@ -0,0 +1,30 @@
+import { expect, test } from "vitest";
+
+import * as z from "zod/v4";
+
+test("valid SemVer 2.0.0 versions parse successfully", () => {
+  expect(z.semver().parse("1.0.0")).toBe("1.0.0");
+  expect(z.semver().parse("1.2.3-alpha.1")).toBe("1.2.3-alpha.1");
+  expect(z.semver().parse("1.0.0+build.5")).toBe("1.0.0+build.5");
+  expect(z.semver().parse("1.0.0-rc.1+build.1")).toBe("1.0.0-rc.1+build.1");
+});
+
+test("invalid versions fail validation", () => {
+  expect(z.semver().safeParse("1.0").success).toBe(false); // missing patch
+  expect(z.semver().safeParse("v1.0.0").success).toBe(false); // leading v
+  expect(z.semver().safeParse("01.0.0").success).toBe(false); // leading zero
+  expect(z.semver().safeParse("1.0.0-").success).toBe(false); // empty prerelease
+  expect(z.semver().safeParse("").success).toBe(false);
+});
+
+test("a custom error message passed as params surfaces on failure", () => {
+  const result = z.semver("not a version").safeParse("nope");
+  expect(result.success).toBe(false);
+  expect(result.error!.issues[0].message).toBe("not a version");
+});
+
+test("z.semver() is chainable", () => {
+  const schema = z.semver().min(6);
+  expect(schema.parse("1.20.30")).toBe("1.20.30");
+  expect(schema.safeParse("1.0.0").success).toBe(false); // too short
+});
