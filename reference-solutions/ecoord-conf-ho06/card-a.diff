@@ -0,0 +1,29 @@
+import { Hono } from './hono'
+
+describe('app.route() argument guard', () => {
+  it('Should still mount a sub-app and serve its routes', async () => {
+    const app = new Hono()
+    const sub = new Hono()
+    sub.get('/user', (c) => c.text('user'))
+    app.route('/api', sub)
+
+    const res = await app.request('http://localhost/api/user')
+    expect(res.status).toBe(200)
+    expect(await res.text()).toBe('user')
+  })
+
+  it('Should throw a TypeError for undefined', () => {
+    const app = new Hono()
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    expect(() => app.route('/api', undefined as any)).toThrow(TypeError)
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    expect(() => app.route('/api', undefined as any)).toThrow(/Hono instance/)
+  })
+
+  it('Should throw a TypeError for a handler function', () => {
+    const app = new Hono()
+    const handler = () => new Response('ok')
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    expect(() => app.route('/api', handler as any)).toThrow(TypeError)
+  })
+})
