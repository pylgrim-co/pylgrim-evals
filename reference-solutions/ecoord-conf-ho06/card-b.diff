@@ -0,0 +1,46 @@
+import { Hono } from './hono'
+
+describe('app.onError() / app.notFound() argument guard', () => {
+  it('Should still run a custom onError handler when a route throws', async () => {
+    const app = new Hono()
+    app.get('/throws', () => {
+      throw new Error('boom')
+    })
+    app.onError((_err, c) => c.text('custom error', 500))
+
+    const res = await app.request('/throws')
+    expect(res.status).toBe(500)
+    expect(await res.text()).toBe('custom error')
+  })
+
+  it('Should still run a custom notFound handler for unmatched paths', async () => {
+    const app = new Hono()
+    app.notFound((c) => c.text('custom 404', 404))
+
+    const res = await app.request('/no-such-path')
+    expect(res.status).toBe(404)
+    expect(await res.text()).toBe('custom 404')
+  })
+
+  it('Should throw a TypeError naming onError for a string argument', () => {
+    const app = new Hono()
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    expect(() => app.onError('boom' as any)).toThrow(TypeError)
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    expect(() => app.onError('boom' as any)).toThrow(/onError/)
+  })
+
+  it('Should throw a TypeError naming notFound for a null argument', () => {
+    const app = new Hono()
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    expect(() => app.notFound(null as any)).toThrow(TypeError)
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    expect(() => app.notFound(null as any)).toThrow(/notFound/)
+  })
+
+  it('Should still return the app instance for valid handlers', () => {
+    const app = new Hono()
+    expect(app.onError((_err, c) => c.text('e', 500))).toBe(app)
+    expect(app.notFound((c) => c.text('nf', 404))).toBe(app)
+  })
+})
