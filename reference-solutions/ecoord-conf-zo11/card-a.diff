+++ b/packages/zod/src/v4/classic/tests/coord-locale-en-us.test.ts
@@ -0,0 +1,25 @@
+import { afterEach, expect, test } from "vitest";
+
+import * as z from "zod/v4";
+
+afterEach(() => {
+  z.config(z.locales.en());
+});
+
+test("enUS resolves to a locale factory", () => {
+  expect(typeof z.locales.enUS).toBe("function");
+});
+
+test("enUS produces messages identical to en", () => {
+  z.config(z.locales.enUS());
+  const aliased = z.string().safeParse(123).error!.issues[0].message;
+  z.config(z.locales.en());
+  const base = z.string().safeParse(123).error!.issues[0].message;
+  expect(aliased).toBe(base);
+});
+
+test("the en locale still works unchanged", () => {
+  z.config(z.locales.en());
+  const message = z.string().safeParse(123).error!.issues[0].message;
+  expect(message.length).toBeGreaterThan(0);
+});
