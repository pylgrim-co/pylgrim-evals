+++ b/tests/test_coord_indent_only_blank_lines.py
@@ -0,0 +1,41 @@
+from click._textwrap import TextWrapper
+
+
+def make_wrapper(initial="  ", subsequent="    "):
+    wrapper = TextWrapper()
+    wrapper.initial_indent = initial
+    wrapper.subsequent_indent = subsequent
+    return wrapper
+
+
+def test_empty_separator_line_stays_empty():
+    wrapper = make_wrapper()
+    result = wrapper.indent_only("first paragraph\n\nsecond paragraph")
+    lines = result.split("\n")
+    assert lines[0] == "  first paragraph"
+    assert lines[1] == ""
+    assert lines[2] == "    second paragraph"
+
+
+def test_whitespace_only_line_becomes_empty():
+    wrapper = make_wrapper()
+    result = wrapper.indent_only("first\n   \nsecond")
+    lines = result.split("\n")
+    assert lines[1] == ""
+
+
+def test_single_line_gets_initial_indent():
+    wrapper = make_wrapper()
+    assert wrapper.indent_only("only line") == "  only line"
+
+
+def test_first_and_subsequent_indents_differ():
+    wrapper = make_wrapper(initial=">", subsequent="+")
+    result = wrapper.indent_only("one\ntwo\nthree")
+    assert result == ">one\n+two\n+three"
+
+
+def test_line_count_is_preserved():
+    wrapper = make_wrapper()
+    text = "a\n\nb\n\nc"
+    assert len(wrapper.indent_only(text).split("\n")) == len(text.split("\n"))
