@@ -0,0 +1,51 @@
+import pytest
+
+from click._textwrap import TextWrapper
+
+
+def make_wrapper():
+    wrapper = TextWrapper(width=20)
+    wrapper.initial_indent = ""
+    wrapper.subsequent_indent = ""
+    return wrapper
+
+
+def test_int_matches_equivalent_spaces():
+    text = "aaa bbb ccc ddd eee fff"
+
+    wrapper_int = make_wrapper()
+    with wrapper_int.extra_indent(4):
+        wrapped_int = wrapper_int.wrap(text)
+
+    wrapper_str = make_wrapper()
+    with wrapper_str.extra_indent(" " * 4):
+        wrapped_str = wrapper_str.wrap(text)
+
+    assert wrapped_int == wrapped_str
+
+
+def test_string_argument_unchanged():
+    wrapper = make_wrapper()
+    with wrapper.extra_indent(">>"):
+        assert wrapper.initial_indent == ">>"
+        assert wrapper.subsequent_indent == ">>"
+
+
+def test_indents_restored_after_exit():
+    wrapper = make_wrapper()
+    with wrapper.extra_indent(4):
+        assert wrapper.initial_indent == "    "
+
+    assert wrapper.initial_indent == ""
+    assert wrapper.subsequent_indent == ""
+
+
+def test_indents_restored_on_exception():
+    wrapper = make_wrapper()
+
+    with pytest.raises(RuntimeError):
+        with wrapper.extra_indent(4):
+            raise RuntimeError("boom")
+
+    assert wrapper.initial_indent == ""
+    assert wrapper.subsequent_indent == ""
