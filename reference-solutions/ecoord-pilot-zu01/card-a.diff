diff --git a/src/middleware/combine.ts b/src/middleware/combine.ts
index e306a81..19bd84e 100644
--- a/src/middleware/combine.ts
+++ b/src/middleware/combine.ts
@@ -11,5 +11,18 @@ export function combine<
   initialState: T,
   create: StateCreator<T, Mps, Mcs, U>,
 ): StateCreator<Write<T, U>, Mps, Mcs> {
-  return (...args) => Object.assign({}, initialState, (create as any)(...args))
+  return (...args) => {
+    const additionalState = (create as any)(...args)
+    if (process.env.NODE_ENV !== 'production') {
+      const overlappingKeys = Object.keys(additionalState).filter(
+        (key) => key in initialState,
+      )
+      if (overlappingKeys.length > 0) {
+        console.warn(
+          `[zustand combine] initialState keys overwritten by the create result: ${overlappingKeys.join(', ')}`,
+        )
+      }
+    }
+    return Object.assign({}, initialState, additionalState)
+  }
 }
diff --git a/tests/coord/combine-overlap.test.ts b/tests/coord/combine-overlap.test.ts
new file mode 100644
index 0000000..2c7d205
--- /dev/null
+++ b/tests/coord/combine-overlap.test.ts
@@ -0,0 +1,33 @@
+import { afterAll, afterEach, expect, it, vi } from 'vitest'
+import { combine } from 'zustand/middleware'
+import { createStore } from 'zustand/vanilla'
+
+const warnSpy = vi.spyOn(console, 'warn').mockImplementation(() => {})
+
+afterEach(() => {
+  warnSpy.mockClear()
+})
+
+afterAll(() => {
+  warnSpy.mockRestore()
+})
+
+it('warns once and names the keys when create() overwrites initialState keys', () => {
+  createStore(combine({ count: 0, label: 'x' }, () => ({ count: 5 })))
+  expect(warnSpy).toHaveBeenCalledTimes(1)
+  const message = warnSpy.mock.calls[0]![0] as string
+  expect(message).toContain('count')
+  expect(message).not.toContain('label')
+})
+
+it('does not warn when initialState and the create result are disjoint', () => {
+  createStore(combine({ count: 0 }, () => ({ label: 'x' })))
+  expect(warnSpy).not.toHaveBeenCalled()
+})
+
+it('produces the same merged state as before', () => {
+  const store = createStore(
+    combine({ count: 0, label: 'x' }, () => ({ count: 5 })),
+  )
+  expect(store.getState()).toEqual({ count: 5, label: 'x' })
+})
