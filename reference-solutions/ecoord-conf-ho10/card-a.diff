--- /dev/null
+++ b/src/middleware/powered-by/coord-append-option.test.ts
@@ -0,0 +1,36 @@
+import { Hono } from '../../hono'
+import { poweredBy } from '.'
+
+describe('Powered by Middleware with append option', () => {
+  it('Should append to an existing X-Powered-By header', async () => {
+    const app = new Hono()
+    app.use('*', poweredBy({ append: true }))
+    app.get('/', (c) => c.body('hi', 200, { 'X-Powered-By': 'Express' }))
+    const res = await app.request('/')
+    expect(res.headers.get('X-Powered-By')).toBe('Express, Hono')
+  })
+
+  it('Should append the custom serverName', async () => {
+    const app = new Hono()
+    app.use('*', poweredBy({ append: true, serverName: 'Foo' }))
+    app.get('/', (c) => c.body('hi', 200, { 'X-Powered-By': 'Express' }))
+    const res = await app.request('/')
+    expect(res.headers.get('X-Powered-By')).toBe('Express, Foo')
+  })
+
+  it('Should set the value alone when no header exists', async () => {
+    const app = new Hono()
+    app.use('*', poweredBy({ append: true }))
+    app.get('/', (c) => c.text('hi'))
+    const res = await app.request('/')
+    expect(res.headers.get('X-Powered-By')).toBe('Hono')
+  })
+
+  it('Should overwrite an existing header without the option', async () => {
+    const app = new Hono()
+    app.use('*', poweredBy())
+    app.get('/', (c) => c.body('hi', 200, { 'X-Powered-By': 'Express' }))
+    const res = await app.request('/')
+    expect(res.headers.get('X-Powered-By')).toBe('Hono')
+  })
+})
