@@ -0,0 +1,25 @@
+import type { StateCreator, StoreMutatorIdentifier } from '../vanilla.ts'
+
+export function validate<
+  T extends object,
+  Mps extends [StoreMutatorIdentifier, unknown][] = [],
+  Mcs extends [StoreMutatorIdentifier, unknown][] = [],
+>(
+  initializer: StateCreator<T, Mps, Mcs>,
+  validator: (state: T) => void,
+): StateCreator<T, Mps, Mcs> {
+  return (set, get, api) => {
+    const origSetState = (api as any).setState
+    ;(api as any).setState = (...args: unknown[]) => {
+      const result = origSetState(...args)
+      validator((api as any).getState())
+      return result
+    }
+    const validatingSet = ((...args: unknown[]) => {
+      const result = (set as any)(...args)
+      validator((api as any).getState())
+      return result
+    }) as typeof set
+    return initializer(validatingSet, get, api)
+  }
+}
