+import { expect, it, vi } from 'vitest'
+import { validate } from 'zustand/middleware'
+import { createStore } from 'zustand/vanilla'
+import type { StateCreator } from 'zustand/vanilla'
+
+type CounterState = { count: number; inc: () => void }
+
+const counterInitializer: StateCreator<CounterState> = (set, get) => ({
+  count: 0,
+  inc: () => set({ count: get().count + 1 }),
+})
+
+it('resolves from the middleware registry and is not called at store creation', () => {
+  const validator = vi.fn()
+  createStore(validate(counterInitializer, validator))
+  expect(typeof validate).toBe('function')
+  expect(validator).not.toHaveBeenCalled()
+})
+
+it('is called exactly once with the post-update state after each api.setState', () => {
+  const validator = vi.fn()
+  const store = createStore(validate(counterInitializer, validator))
+  store.setState({ count: 1 })
+  expect(validator).toHaveBeenCalledTimes(1)
+  expect(validator).toHaveBeenLastCalledWith(
+    expect.objectContaining({ count: 1 }),
+  )
+  store.setState({ count: 2 })
+  expect(validator).toHaveBeenCalledTimes(2)
+  expect(validator).toHaveBeenLastCalledWith(
+    expect.objectContaining({ count: 2 }),
+  )
+})
+
+it('fires for updates made through the initializer-provided set', () => {
+  const validator = vi.fn()
+  const store = createStore(validate(counterInitializer, validator))
+  store.getState().inc()
+  expect(validator).toHaveBeenCalledTimes(1)
+  expect(validator).toHaveBeenLastCalledWith(
+    expect.objectContaining({ count: 1 }),
+  )
+})
+
+it('a throwing validator propagates to the caller and the update is kept', () => {
+  const store = createStore(
+    validate(counterInitializer, (state) => {
+      if (state.count > 3) {
+        throw new Error('count must stay small')
+      }
+    }),
+  )
+  store.setState({ count: 2 })
+  expect(store.getState().count).toBe(2)
+  expect(() => store.setState({ count: 10 })).toThrow('count must stay small')
+  expect(store.getState().count).toBe(10)
+})
