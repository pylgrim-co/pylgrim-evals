--- /dev/null
+++ b/src/middleware/freeze.ts
@@ -0,0 +1,22 @@
+import type { StateCreator, StoreMutatorIdentifier } from '../vanilla.ts'
+
+export function freeze<
+  T extends object,
+  Mps extends [StoreMutatorIdentifier, unknown][] = [],
+  Mcs extends [StoreMutatorIdentifier, unknown][] = [],
+>(initializer: StateCreator<T, Mps, Mcs>): StateCreator<T, Mps, Mcs> {
+  return (set, get, api) => {
+    const origSetState = (api as any).setState
+    ;(api as any).setState = (...args: unknown[]) => {
+      const result = origSetState(...args)
+      Object.freeze((api as any).getState())
+      return result
+    }
+    const freezingSet = ((...args: unknown[]) => {
+      const result = (set as any)(...args)
+      Object.freeze((api as any).getState())
+      return result
+    }) as typeof set
+    return Object.freeze(initializer(freezingSet, get, api))
+  }
+}
diff --git a/tests/coord/freeze-middleware.test.ts b/tests/coord/freeze-middleware.test.ts
