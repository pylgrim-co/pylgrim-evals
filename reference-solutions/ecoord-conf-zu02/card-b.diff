@@ -0,0 +1,51 @@
+import { expect, it, vi } from 'vitest'
+import { freeze } from 'zustand/middleware'
+import { createStore } from 'zustand/vanilla'
+import type { StateCreator } from 'zustand/vanilla'
+
+type State = { count: number; nested: { value: number } }
+
+const initializer: StateCreator<State> = () => ({
+  count: 0,
+  nested: { value: 1 },
+})
+
+it('the state object is frozen right after creation', () => {
+  const store = createStore(freeze(initializer))
+  expect(Object.isFrozen(store.getState())).toBe(true)
+})
+
+it('the state object is frozen again after a setState', () => {
+  const store = createStore(freeze(initializer))
+  store.setState({ count: 1 })
+  expect(store.getState().count).toBe(1)
+  expect(Object.isFrozen(store.getState())).toBe(true)
+})
+
+it('direct property assignment on the state throws TypeError in strict mode', () => {
+  const store = createStore(freeze(initializer))
+  expect(() => {
+    ;(store.getState() as { count: number }).count = 99
+  }).toThrow(TypeError)
+  expect(store.getState().count).toBe(0)
+})
+
+it('setState still merges partials and notifies subscribers normally', () => {
+  const store = createStore(freeze(initializer))
+  const listener = vi.fn()
+  store.subscribe(listener)
+  store.setState({ count: 2 })
+  expect(store.getState()).toEqual({ count: 2, nested: { value: 1 } })
+  expect(listener).toHaveBeenCalledTimes(1)
+  expect(listener).toHaveBeenCalledWith(
+    expect.objectContaining({ count: 2 }),
+    expect.objectContaining({ count: 0 }),
+  )
+})
+
+it('the freeze is shallow: nested objects stay mutable', () => {
+  const store = createStore(freeze(initializer))
+  expect(Object.isFrozen(store.getState().nested)).toBe(false)
+  store.getState().nested.value = 42
+  expect(store.getState().nested.value).toBe(42)
+})
