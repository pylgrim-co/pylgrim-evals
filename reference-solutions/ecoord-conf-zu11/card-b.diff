--- /dev/null
+++ b/tests/coord/create-with-equality-arg-guard.test.ts
@@ -0,0 +1,24 @@
+import { expect, it } from 'vitest'
+import { createWithEqualityFn } from 'zustand/traditional'
+
+it('throws TypeError for a number or null initializer', () => {
+  expect(() => createWithEqualityFn(42 as any)).toThrow(TypeError)
+  expect(() => createWithEqualityFn(null as any)).toThrow(TypeError)
+})
+
+it('throws TypeError at creation time for a non-function default equality function', () => {
+  expect(() => createWithEqualityFn(() => ({ count: 0 }), 42 as any)).toThrow(
+    TypeError,
+  )
+})
+
+it('throws TypeError on the curried path for defined non-function values', () => {
+  expect(() => createWithEqualityFn()(42 as any)).toThrow(TypeError)
+})
+
+it('creates a working bound store for a valid initializer', () => {
+  const useBoundStore = createWithEqualityFn(() => ({ count: 5 }), Object.is)
+  expect(useBoundStore.getState().count).toBe(5)
+  useBoundStore.setState({ count: 6 })
+  expect(useBoundStore.getState().count).toBe(6)
+})
