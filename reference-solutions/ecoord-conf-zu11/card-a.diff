@@ -0,0 +1,52 @@
+import { render, screen } from '@testing-library/react'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { useStoreWithEqualityFn } from 'zustand/traditional'
+import { createStore } from 'zustand/vanilla'
+
+const consoleError = console.error
+
+beforeEach(() => {
+  console.error = vi.fn()
+})
+
+afterEach(() => {
+  console.error = consoleError
+})
+
+it('throws TypeError when the selector is not a function', () => {
+  const store = createStore(() => ({ count: 0 }))
+  const Component = () => {
+    useStoreWithEqualityFn(store, 42 as any)
+    return null
+  }
+  expect(() => render(<Component />)).toThrow(TypeError)
+})
+
+it('throws TypeError when the equality function is not a function', () => {
+  const store = createStore(() => ({ count: 0 }))
+  const Component = () => {
+    useStoreWithEqualityFn(store, (s) => s.count, 'shallow' as any)
+    return null
+  }
+  expect(() => render(<Component />)).toThrow(TypeError)
+})
+
+it('renders the selected slice with a valid selector and equality function', async () => {
+  const store = createStore(() => ({ count: 9 }))
+  const Component = () => {
+    const count = useStoreWithEqualityFn(store, (s) => s.count, Object.is)
+    return <div>count: {count}</div>
+  }
+  render(<Component />)
+  expect(await screen.findByText('count: 9')).toBeDefined()
+})
+
+it('renders the whole state without a selector', async () => {
+  const store = createStore(() => ({ label: 'whole' }))
+  const Component = () => {
+    const state = useStoreWithEqualityFn(store)
+    return <div>label: {state.label}</div>
+  }
+  render(<Component />)
+  expect(await screen.findByText('label: whole')).toBeDefined()
+})
