--- /dev/null
+++ b/packages/zod/src/v4/classic/tests/coord-fjs-hash.test.ts
@@ -0,0 +1,27 @@
+import { expect, test } from "vitest";
+import { fromJSONSchema } from "../from-json-schema.js";
+
+test("hex format accepts hex strings and rejects non-hex input", () => {
+  const schema = fromJSONSchema({ type: "string", format: "hex" });
+  expect(schema.parse("deadBEEF01")).toBe("deadBEEF01");
+  expect(() => schema.parse("xyz")).toThrow();
+});
+
+test("md5 format accepts 32-char hex digests only", () => {
+  const schema = fromJSONSchema({ type: "string", format: "md5" });
+  const digest = "d41d8cd98f00b204e9800998ecf8427e";
+  expect(schema.parse(digest)).toBe(digest);
+  expect(() => schema.parse(digest.slice(0, 31))).toThrow();
+});
+
+test("sha256 format accepts 64-char hex digests only", () => {
+  const schema = fromJSONSchema({ type: "string", format: "sha256" });
+  const digest = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
+  expect(schema.parse(digest)).toBe(digest);
+  expect(() => schema.parse(digest.slice(0, 63))).toThrow();
+});
+
+test("unmapped custom formats still convert to plain strings", () => {
+  const schema = fromJSONSchema({ type: "string", format: "my-format" });
+  expect(schema.parse("anything at all")).toBe("anything at all");
+});
