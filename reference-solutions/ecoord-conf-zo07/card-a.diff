+++ b/packages/zod/src/v4/classic/tests/coord-fjs-hostname.test.ts
@@ -0,0 +1,37 @@
+import { expect, test } from "vitest";
+import { fromJSONSchema } from "../from-json-schema.js";
+
+test("hostname format accepts valid hostnames", () => {
+  const schema = fromJSONSchema({ type: "string", format: "hostname" });
+  expect(schema.parse("example.com")).toBe("example.com");
+  expect(schema.parse("sub.example-site.org")).toBe("sub.example-site.org");
+});
+
+test("hostname format rejects invalid hostnames", () => {
+  const schema = fromJSONSchema({ type: "string", format: "hostname" });
+  expect(() => schema.parse("exa mple.com")).toThrow();
+  expect(() => schema.parse("-leading.example.com")).toThrow();
+});
+
+test("idn-hostname maps to the same check", () => {
+  const schema = fromJSONSchema({ type: "string", format: "idn-hostname" });
+  expect(schema.parse("example.com")).toBe("example.com");
+  expect(() => schema.parse("exa mple.com")).toThrow();
+});
+
+test("unmapped custom formats still convert to plain strings", () => {
+  const schema = fromJSONSchema({ type: "string", format: "my-format" });
+  expect(schema.parse("anything at all")).toBe("anything at all");
+});
+
+test("length constraints combine with the hostname format", () => {
+  const schema = fromJSONSchema({
+    type: "string",
+    format: "hostname",
+    minLength: 5,
+    maxLength: 15,
+  });
+  expect(schema.parse("example.com")).toBe("example.com");
+  expect(() => schema.parse("a.io")).toThrow();
+  expect(() => schema.parse("much-too-long-hostname.example.com")).toThrow();
+});
