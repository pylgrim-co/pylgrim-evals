@@ -420,17 +420,33 @@ class Choice(ParamType[_ValueT_co], t.Generic[_ValueT_co]):
     def get_invalid_choice_message(self, value: t.Any, ctx: Context | None) -> str:
         """Get the error message when the given choice is invalid.
 
+        When the invalid value is close to one or more of the valid
+        choices, a ``Did you mean`` suggestion sentence is appended to
+        the message. When nothing is close, the message is unchanged.
+
         :param value: The invalid value.
 
         .. versionadded:: 8.2
         """
-        choices_str = ", ".join(map(repr, self._normalized_mapping(ctx=ctx).values()))
-        return ngettext(
+        from difflib import get_close_matches
+
+        normalized_choices = list(self._normalized_mapping(ctx=ctx).values())
+        choices_str = ", ".join(map(repr, normalized_choices))
+        message = ngettext(
             "{value!r} is not {choice}.",
             "{value!r} is not one of {choices}.",
             len(self.choices),
         ).format(value=value, choice=choices_str, choices=choices_str)
 
+        normed_value = self.normalize_choice(choice=value, ctx=ctx)
+        matches = get_close_matches(normed_value, normalized_choices)
+
+        if matches:
+            suggestion = " or ".join(map(repr, matches))
+            message = f"{message} Did you mean {suggestion}?"
+
+        return message
+
     def __repr__(self) -> str:
         return _("Choice({choices})").format(choices=list(self.choices))
 
diff --git a/tests/test_coord_choice_suggestions.py b/tests/test_coord_choice_suggestions.py
new file mode 100644
index 0000000..85b6cac
--- /dev/null
+++ b/tests/test_coord_choice_suggestions.py
@@ -0,0 +1,33 @@
+import pytest
+
+import click
+
+
+def test_close_typo_gets_a_suggestion():
+    with pytest.raises(click.UsageError) as exc_info:
+        click.Choice(["push", "pull"]).convert("puhs", None, None)
+
+    message = exc_info.value.message
+    assert "'puhs' is not one of 'push', 'pull'." in message
+    assert "Did you mean 'push'?" in message
+
+
+def test_far_off_value_keeps_current_message():
+    with pytest.raises(click.UsageError) as exc_info:
+        click.Choice(["push", "pull"]).convert("zebra", None, None)
+
+    message = exc_info.value.message
+    assert message == "'zebra' is not one of 'push', 'pull'."
+    assert "Did you mean" not in message
+
+
+def test_cli_invocation_shows_suggestion(runner):
+    @click.command()
+    @click.option("--opt", type=click.Choice(["push", "pull"]))
+    def cli(opt):
+        click.echo(opt)
+
+    result = runner.invoke(cli, ["--opt", "puhs"])
+    assert result.exit_code == 2
+    assert "'puhs' is not one of 'push', 'pull'." in result.output
+    assert "Did you mean 'push'?" in result.output
