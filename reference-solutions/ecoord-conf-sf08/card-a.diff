+import dedent from 'dedent-js';
+
+import { format as originalFormat, FormatFn } from '../src/sqlFormatter.js';
+
+describe('spark modern string helper functions', () => {
+  const format: FormatFn = (query, cfg = {}) =>
+    originalFormat(query, { ...cfg, language: 'spark' });
+
+  it('uppercases split_part and startswith with functionCase: "upper"', () => {
+    const result = format("SELECT split_part(a, '-', 1), startswith(a, 'x') FROM t", {
+      functionCase: 'upper',
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        SPLIT_PART(a, '-', 1),
+        STARTSWITH(a, 'x')
+      FROM
+        t
+    `);
+  });
+
+  it('lowercases ENDSWITH with functionCase: "lower"', () => {
+    const result = format("SELECT ENDSWITH(a, 'x') FROM t", { functionCase: 'lower' });
+    expect(result).toBe(dedent`
+      SELECT
+        endswith(a, 'x')
+      FROM
+        t
+    `);
+  });
+
+  it('still uppercases the existing btrim function', () => {
+    const result = format('SELECT btrim(a) FROM t', { functionCase: 'upper' });
+    expect(result).toBe(dedent`
+      SELECT
+        BTRIM(a)
+      FROM
+        t
+    `);
+  });
+
+  it('leaves unrelated identifiers untouched by functionCase', () => {
+    const result = format('SELECT my_column FROM t', { functionCase: 'upper' });
+    expect(result).toBe(dedent`
+      SELECT
+        my_column
+      FROM
+        t
+    `);
+  });
+});
