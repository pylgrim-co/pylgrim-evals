@@ -0,0 +1,41 @@
+import { Hono } from '../../hono'
+import { etag } from '.'
+
+describe('Etag Middleware with skipStatuses option', () => {
+  const makeApp = (skipStatuses?: number[]) => {
+    const app = new Hono()
+    app.use('/etag/*', etag(skipStatuses ? { skipStatuses } : undefined))
+    app.get('/etag/partial', (c) => c.body('partial content', 206))
+    app.get('/etag/full', (c) => c.text('full content'))
+    return app
+  }
+
+  it('Should not set an ETag on a skipped status', async () => {
+    const res = await makeApp([206]).request('/etag/partial')
+    expect(res.status).toBe(206)
+    expect(res.headers.get('ETag')).toBeNull()
+  })
+
+  it('Should still set an ETag on non-skipped statuses', async () => {
+    const res = await makeApp([206]).request('/etag/full')
+    expect(res.status).toBe(200)
+    expect(res.headers.get('ETag')).not.toBeNull()
+  })
+
+  it('Should not convert a skipped status to 304 on If-None-Match', async () => {
+    const app = makeApp([206])
+    const first = await app.request('/etag/full')
+    const tag = first.headers.get('ETag') as string
+    const res = await app.request('/etag/partial', {
+      headers: { 'If-None-Match': tag },
+    })
+    expect(res.status).toBe(206)
+    expect(await res.text()).toBe('partial content')
+  })
+
+  it('Should keep today's behavior without the option', async () => {
+    const res = await makeApp().request('/etag/partial')
+    expect(res.status).toBe(206)
+    expect(res.headers.get('ETag')).not.toBeNull()
+  })
+})
