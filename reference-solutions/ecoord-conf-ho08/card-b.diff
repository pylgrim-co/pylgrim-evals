+import { Hono } from '../../hono'
+import { etag } from '.'
+
+describe('Etag Middleware with vary option', () => {
+  const makeApp = (vary?: string[]) => {
+    const app = new Hono()
+    app.use('/etag/*', etag(vary ? { vary } : undefined))
+    app.get('/etag/plain', (c) => c.text('body'))
+    app.get('/etag/origin', (c) => {
+      c.header('Vary', 'Origin')
+      return c.text('body')
+    })
+    app.get('/etag/dupe', (c) => {
+      c.header('Vary', 'accept-encoding')
+      return c.text('body')
+    })
+    return app
+  }
+
+  const varyNames = (res: Response) =>
+    (res.headers.get('Vary') ?? '')
+      .split(',')
+      .map((name) => name.trim().toLowerCase())
+      .filter((name) => name.length > 0)
+
+  it('Should carry the listed names in Vary next to the ETag', async () => {
+    const res = await makeApp(['Accept-Encoding']).request('/etag/plain')
+    expect(res.headers.get('ETag')).not.toBeNull()
+    expect(varyNames(res)).toContain('accept-encoding')
+  })
+
+  it('Should preserve and extend an existing Vary header', async () => {
+    const res = await makeApp(['Accept-Encoding']).request('/etag/origin')
+    const names = varyNames(res)
+    expect(names).toContain('origin')
+    expect(names).toContain('accept-encoding')
+  })
+
+  it('Should not duplicate a name already present in any case', async () => {
+    const res = await makeApp(['Accept-Encoding']).request('/etag/dupe')
+    const names = varyNames(res).filter((name) => name === 'accept-encoding')
+    expect(names).toHaveLength(1)
+  })
+
+  it('Should never touch Vary without the option', async () => {
+    const res = await makeApp().request('/etag/plain')
+    expect(res.headers.get('ETag')).not.toBeNull()
+    expect(res.headers.get('Vary')).toBeNull()
+  })
+})
