@@ -0,0 +1,31 @@
+import { getColorEnabled, getColorEnabledAsync } from './color'
+
+describe('getColorEnabled() with an empty NO_COLOR', () => {
+  afterEach(() => {
+    vi.unstubAllEnvs()
+  })
+
+  it('Should keep color enabled when NO_COLOR is the empty string', () => {
+    vi.stubEnv('NO_COLOR', '')
+    expect(getColorEnabled()).toBe(true)
+  })
+
+  it('Should disable color when NO_COLOR is "1"', () => {
+    vi.stubEnv('NO_COLOR', '1')
+    expect(getColorEnabled()).toBe(false)
+  })
+
+  it('Should disable color when NO_COLOR is "0" (any non-empty value counts)', () => {
+    vi.stubEnv('NO_COLOR', '0')
+    expect(getColorEnabled()).toBe(false)
+  })
+
+  it('Should keep color enabled when NO_COLOR is unset', () => {
+    expect(getColorEnabled()).toBe(true)
+  })
+
+  it('Should mirror the behavior in getColorEnabledAsync outside Cloudflare', async () => {
+    vi.stubEnv('NO_COLOR', '')
+    expect(await getColorEnabledAsync()).toBe(true)
+  })
+})
