@@ -0,0 +1,34 @@
+import { getColorEnabled, getColorEnabledAsync } from './color'
+
+describe('getColorEnabled() with FORCE_COLOR', () => {
+  afterEach(() => {
+    vi.unstubAllEnvs()
+  })
+
+  it('Should return true when FORCE_COLOR is set to a non-empty value', () => {
+    vi.stubEnv('FORCE_COLOR', '1')
+    expect(getColorEnabled()).toBe(true)
+  })
+
+  it('Should beat NO_COLOR when both are set', () => {
+    vi.stubEnv('NO_COLOR', '1')
+    vi.stubEnv('FORCE_COLOR', '1')
+    expect(getColorEnabled()).toBe(true)
+  })
+
+  it('Should not force color when FORCE_COLOR is empty', () => {
+    vi.stubEnv('NO_COLOR', '1')
+    vi.stubEnv('FORCE_COLOR', '')
+    expect(getColorEnabled()).toBe(false)
+  })
+
+  it('Should behave as before when FORCE_COLOR is unset', () => {
+    expect(getColorEnabled()).toBe(true)
+  })
+
+  it('Should mirror the override in getColorEnabledAsync outside Cloudflare', async () => {
+    vi.stubEnv('NO_COLOR', '1')
+    vi.stubEnv('FORCE_COLOR', '1')
+    expect(await getColorEnabledAsync()).toBe(true)
+  })
+})
