+import dedent from 'dedent-js';
+
+import { format as originalFormat, FormatFn } from '../src/sqlFormatter.js';
+
+describe('mariadb json equality and normalization functions', () => {
+  const format: FormatFn = (query, cfg = {}) =>
+    originalFormat(query, { ...cfg, language: 'mariadb' });
+
+  it('uppercases json_equals and json_normalize with functionCase: "upper"', () => {
+    const result = format('SELECT json_equals(a, b), json_normalize(c) FROM t', {
+      functionCase: 'upper',
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        JSON_EQUALS(a, b),
+        JSON_NORMALIZE(c)
+      FROM
+        t
+    `);
+  });
+
+  it('lowercases JSON_EQUALS and JSON_NORMALIZE with functionCase: "lower"', () => {
+    const result = format('SELECT JSON_EQUALS(a, b), JSON_NORMALIZE(c) FROM t', {
+      functionCase: 'lower',
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        json_equals(a, b),
+        json_normalize(c)
+      FROM
+        t
+    `);
+  });
+
+  it('still uppercases the existing json_valid function', () => {
+    const result = format('SELECT json_valid(a) FROM t', { functionCase: 'upper' });
+    expect(result).toBe(dedent`
+      SELECT
+        JSON_VALID(a)
+      FROM
+        t
+    `);
+  });
+
+  it('leaves unrelated identifiers untouched by functionCase', () => {
+    const result = format('SELECT my_column FROM t', { functionCase: 'upper' });
+    expect(result).toBe(dedent`
+      SELECT
+        my_column
+      FROM
+        t
+    `);
+  });
+});
