diff --git a/test/coord-trino-vector-functions.test.ts b/test/coord-trino-vector-functions.test.ts
new file mode 100644
index 00000000..1a125efe
--- /dev/null
+++ b/test/coord-trino-vector-functions.test.ts
@@ -0,0 +1,61 @@
+import dedent from 'dedent-js';
+
+import { format as originalFormat, FormatFn } from '../src/sqlFormatter.js';
+
+describe('trino newer vector and aggregate functions', () => {
+  const format: FormatFn = (query, cfg = {}) =>
+    originalFormat(query, { ...cfg, language: 'trino' });
+
+  it('uppercases cosine_distance, dot_product, any_value and sinh with functionCase: "upper"', () => {
+    const result = format(
+      'SELECT cosine_distance(u, v), dot_product(u, v), any_value(x), sinh(y) FROM tbl',
+      { functionCase: 'upper' }
+    );
+    expect(result).toBe(dedent`
+      SELECT
+        COSINE_DISTANCE(u, v),
+        DOT_PRODUCT(u, v),
+        ANY_VALUE(x),
+        SINH(y)
+      FROM
+        tbl
+    `);
+  });
+
+  it('lowercases EUCLIDEAN_DISTANCE and ARRAY_HISTOGRAM with functionCase: "lower"', () => {
+    const result = format('SELECT EUCLIDEAN_DISTANCE(u, v), ARRAY_HISTOGRAM(x) FROM tbl', {
+      functionCase: 'lower',
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        euclidean_distance(u, v),
+        array_histogram(x)
+      FROM
+        tbl
+    `);
+  });
+
+  it('preserves mixed-case spellings of the new functions by default', () => {
+    const result = format('SELECT Any_Value(x), Dot_Product(u, v) FROM tbl');
+    expect(result).toBe(dedent`
+      SELECT
+        Any_Value(x),
+        Dot_Product(u, v)
+      FROM
+        tbl
+    `);
+  });
+
+  it('does not uppercase unknown function names with functionCase: "upper"', () => {
+    const result = format('SELECT my_custom_fn(x), sinh(y) FROM tbl', {
+      functionCase: 'upper',
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        my_custom_fn(x),
+        SINH(y)
+      FROM
+        tbl
+    `);
+  });
+});
