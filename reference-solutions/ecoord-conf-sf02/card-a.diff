@@ -0,0 +1,61 @@
+import dedent from 'dedent-js';
+
+import { format as originalFormat, FormatFn } from '../src/sqlFormatter.js';
+
+describe('snowflake newer array and utility functions', () => {
+  const format: FormatFn = (query, cfg = {}) =>
+    originalFormat(query, { ...cfg, language: 'snowflake' });
+
+  it('uppercases array_min, array_sort, div0null and getdate with functionCase: "upper"', () => {
+    const result = format(
+      'SELECT array_min(v), array_sort(v), div0null(a, b), getdate() FROM tbl',
+      { functionCase: 'upper' }
+    );
+    expect(result).toBe(dedent`
+      SELECT
+        ARRAY_MIN(v),
+        ARRAY_SORT(v),
+        DIV0NULL(a, b),
+        GETDATE()
+      FROM
+        tbl
+    `);
+  });
+
+  it('lowercases ARRAY_MAX and ARRAY_REVERSE with functionCase: "lower"', () => {
+    const result = format('SELECT ARRAY_MAX(v), ARRAY_REVERSE(v) FROM tbl', {
+      functionCase: 'lower',
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        array_max(v),
+        array_reverse(v)
+      FROM
+        tbl
+    `);
+  });
+
+  it('preserves mixed-case spellings of the new functions by default', () => {
+    const result = format('SELECT Array_Min(v), Div0Null(a, b) FROM tbl');
+    expect(result).toBe(dedent`
+      SELECT
+        Array_Min(v),
+        Div0Null(a, b)
+      FROM
+        tbl
+    `);
+  });
+
+  it('does not uppercase unknown function names with functionCase: "upper"', () => {
+    const result = format('SELECT my_custom_fn(x), array_min(v) FROM tbl', {
+      functionCase: 'upper',
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        my_custom_fn(x),
+        ARRAY_MIN(v)
+      FROM
+        tbl
+    `);
+  });
+});
