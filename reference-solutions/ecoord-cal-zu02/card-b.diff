+import { expect, it, vi } from 'vitest'
+import { onStateChange } from 'zustand/middleware'
+import { createStore } from 'zustand/vanilla'
+import type { StateCreator } from 'zustand/vanilla'
+
+type CounterState = { count: number; inc: () => void }
+
+const counterInitializer: StateCreator<CounterState> = (set, get) => ({
+  count: 0,
+  inc: () => set({ count: get().count + 1 }),
+})
+
+it('invokes the callback exactly once per api.setState with (newState, previousState)', () => {
+  const callback = vi.fn()
+  const store = createStore(onStateChange(counterInitializer, callback))
+  store.setState({ count: 1 })
+  expect(callback).toHaveBeenCalledTimes(1)
+  const [next, prev] = callback.mock.calls[0]
+  expect(next.count).toBe(1)
+  expect(prev.count).toBe(0)
+})
+
+it('invokes the callback for changes through the initializer-provided set', () => {
+  const callback = vi.fn()
+  const store = createStore(onStateChange(counterInitializer, callback))
+  store.getState().inc()
+  expect(callback).toHaveBeenCalledTimes(1)
+  expect(store.getState().count).toBe(1)
+})
+
+it('does not invoke the callback at store creation', () => {
+  const callback = vi.fn()
+  createStore(onStateChange(counterInitializer, callback))
+  expect(callback).not.toHaveBeenCalled()
+})
+
+it('propagates a throwing callback to the setState caller and keeps the update', () => {
+  const store = createStore(
+    onStateChange(counterInitializer, () => {
+      throw new Error('observer failed')
+    }),
+  )
+  expect(() => store.setState({ count: 9 })).toThrow('observer failed')
+  expect(store.getState().count).toBe(9)
+})
+
+it('leaves updates and subscriber notification intact', () => {
+  const callback = vi.fn()
+  const store = createStore(onStateChange(counterInitializer, callback))
+  const subscriber = vi.fn()
+  store.subscribe(subscriber)
+  store.setState({ count: 2 })
+  expect(store.getState().count).toBe(2)
+  expect(subscriber).toHaveBeenCalledTimes(1)
+})
