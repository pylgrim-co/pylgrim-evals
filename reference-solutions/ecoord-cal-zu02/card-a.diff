@@ -0,0 +1,57 @@
+import { afterEach, expect, it, vi } from 'vitest'
+import { logger } from 'zustand/middleware'
+import { createStore } from 'zustand/vanilla'
+import type { StateCreator } from 'zustand/vanilla'
+
+type CounterState = { count: number; inc: () => void }
+
+const counterInitializer: StateCreator<CounterState> = (set, get) => ({
+  count: 0,
+  inc: () => set({ count: get().count + 1 }),
+})
+
+afterEach(() => {
+  vi.restoreAllMocks()
+})
+
+it('logs exactly once per api.setState with the name string, previous and new state', () => {
+  const log = vi.spyOn(console, 'log').mockImplementation(() => {})
+  const store = createStore(logger(counterInitializer, 'counter'))
+  store.setState({ count: 1 })
+  expect(log).toHaveBeenCalledTimes(1)
+  const [label, prev, next] = log.mock.calls[0]
+  expect(label).toBe('counter: state changed')
+  expect((prev as CounterState).count).toBe(0)
+  expect((next as CounterState).count).toBe(1)
+})
+
+it('logs changes made through the initializer-provided set', () => {
+  const log = vi.spyOn(console, 'log').mockImplementation(() => {})
+  const store = createStore(logger(counterInitializer, 'counter'))
+  store.getState().inc()
+  expect(log).toHaveBeenCalledTimes(1)
+  expect(store.getState().count).toBe(1)
+})
+
+it('defaults the name to zustand', () => {
+  const log = vi.spyOn(console, 'log').mockImplementation(() => {})
+  const store = createStore(logger(counterInitializer))
+  store.setState({ count: 5 })
+  expect(log.mock.calls[0][0]).toBe('zustand: state changed')
+})
+
+it('does not log at store creation', () => {
+  const log = vi.spyOn(console, 'log').mockImplementation(() => {})
+  createStore(logger(counterInitializer, 'counter'))
+  expect(log).not.toHaveBeenCalled()
+})
+
+it('leaves updates and subscriber notification intact', () => {
+  vi.spyOn(console, 'log').mockImplementation(() => {})
+  const store = createStore(logger(counterInitializer, 'counter'))
+  const subscriber = vi.fn()
+  store.subscribe(subscriber)
+  store.setState({ count: 2 })
+  expect(store.getState().count).toBe(2)
+  expect(subscriber).toHaveBeenCalledTimes(1)
+})
