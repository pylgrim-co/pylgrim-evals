diff --git a/tests/coord/redux-on-action.test.ts b/tests/coord/redux-on-action.test.ts
new file mode 100644
index 0000000..23f6c8c
--- /dev/null
+++ b/tests/coord/redux-on-action.test.ts
@@ -0,0 +1,59 @@
+import { expect, it, vi } from 'vitest'
+import { redux } from 'zustand/middleware'
+import { createStore } from 'zustand/vanilla'
+
+type State = { count: number }
+type Action = { type: string; by?: number }
+
+const reducer = (state: State, action: Action): State => {
+  if (action.type === 'inc') {
+    return { count: state.count + (action.by ?? 1) }
+  }
+  return state
+}
+
+it('onAction receives each dispatched action in order', () => {
+  const seen: Action[] = []
+  const store = createStore(
+    redux(reducer, { count: 0 }, { onAction: (a) => seen.push(a) }),
+  )
+  store.dispatch({ type: 'inc' })
+  store.dispatch({ type: 'inc', by: 3 })
+  expect(seen).toEqual([{ type: 'inc' }, { type: 'inc', by: 3 }])
+})
+
+it('getState() inside the callback observes the post-action state', () => {
+  const observed: number[] = []
+  const store = createStore(
+    redux(reducer, { count: 0 }, {
+      onAction: () => observed.push(store.getState().count),
+    }),
+  )
+  store.dispatch({ type: 'inc' })
+  store.dispatch({ type: 'inc' })
+  expect(observed).toEqual([1, 2])
+})
+
+it('dispatch still returns the action when onAction is provided', () => {
+  const store = createStore(
+    redux(reducer, { count: 0 }, { onAction: vi.fn() }),
+  )
+  const action = { type: 'inc' }
+  expect(store.dispatch(action)).toBe(action)
+})
+
+it('without options the middleware behaves exactly as before', () => {
+  const store = createStore(redux(reducer, { count: 0 }))
+  const action = { type: 'inc', by: 2 }
+  expect(store.dispatch(action)).toBe(action)
+  expect(store.getState().count).toBe(2)
+})
+
+it('multiple dispatches invoke the callback once each', () => {
+  const onAction = vi.fn()
+  const store = createStore(redux(reducer, { count: 0 }, { onAction }))
+  store.dispatch({ type: 'inc' })
+  store.dispatch({ type: 'noop' })
+  store.dispatch({ type: 'inc' })
+  expect(onAction).toHaveBeenCalledTimes(3)
+})
