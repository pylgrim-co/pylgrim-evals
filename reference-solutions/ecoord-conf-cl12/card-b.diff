@@ -0,0 +1,42 @@
+import os
+
+from click._termui_impl import Editor
+
+
+def install_fake_editor(monkeypatch, new_content=None, reset_mtime=False):
+    def fake_edit_files(self, filenames):
+        name = next(iter(filenames))
+        before = os.path.getmtime(name)
+
+        if new_content is not None:
+            with open(name, "wb") as f:
+                f.write(new_content)
+
+        if reset_mtime:
+            os.utime(name, (os.path.getatime(name), before))
+
+    monkeypatch.setattr(Editor, "edit_files", fake_edit_files)
+
+
+def test_same_mtime_save_is_detected(monkeypatch):
+    install_fake_editor(monkeypatch, new_content=b"changed\n", reset_mtime=True)
+    result = Editor(require_save=True).edit("original")
+    assert result == "changed\n"
+
+
+def test_untouched_file_returns_none(monkeypatch):
+    install_fake_editor(monkeypatch)
+    result = Editor(require_save=True).edit("original")
+    assert result is None
+
+
+def test_normal_save_still_works(monkeypatch):
+    install_fake_editor(monkeypatch, new_content=b"changed normally\n")
+    result = Editor(require_save=True).edit("original")
+    assert result == "changed normally\n"
+
+
+def test_no_require_save_returns_text_when_unchanged(monkeypatch):
+    install_fake_editor(monkeypatch)
+    result = Editor(require_save=False).edit("original")
+    assert result == "original\n"
