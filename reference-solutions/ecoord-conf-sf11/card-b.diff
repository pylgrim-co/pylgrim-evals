+import dedent from 'dedent-js';
+
+import { format as originalFormat, FormatFn } from '../src/sqlFormatter.js';
+
+describe('sql dialect SQL:2016 numeric functions', () => {
+  const format: FormatFn = (query, cfg = {}) => originalFormat(query, { ...cfg, language: 'sql' });
+
+  it('uppercases log, log10 and sinh with functionCase: "upper"', () => {
+    const result = format('SELECT log(a), log10(b), sinh(c) FROM t', {
+      functionCase: 'upper',
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        LOG(a),
+        LOG10(b),
+        SINH(c)
+      FROM
+        t
+    `);
+  });
+
+  it('lowercases COSH and TANH with functionCase: "lower"', () => {
+    const result = format('SELECT COSH(a), TANH(b) FROM t', {
+      functionCase: 'lower',
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        cosh(a),
+        tanh(b)
+      FROM
+        t
+    `);
+  });
+
+  it('still uppercases the existing sqrt function', () => {
+    const result = format('SELECT sqrt(a) FROM t', { functionCase: 'upper' });
+    expect(result).toBe(dedent`
+      SELECT
+        SQRT(a)
+      FROM
+        t
+    `);
+  });
+
+  it('leaves unrelated identifiers untouched by functionCase', () => {
+    const result = format('SELECT my_column FROM t', { functionCase: 'upper' });
+    expect(result).toBe(dedent`
+      SELECT
+        my_column
+      FROM
+        t
+    `);
+  });
+});
