@@ -0,0 +1,26 @@
+import { serialize } from './cookie'
+
+describe('Cookie serializer SameSite=None guard', () => {
+  it('Should serialize SameSite=None together with Secure', () => {
+    const serialized = serialize('great_cookie', 'banana', { secure: true, sameSite: 'None' })
+    expect(serialized).toBe('great_cookie=banana; Secure; SameSite=None')
+    expect(serialized).toContain('; Secure; SameSite=None')
+  })
+
+  it('Should throw when SameSite=None is set without Secure', () => {
+    expect(() => serialize('great_cookie', 'banana', { sameSite: 'None' })).toThrowError(
+      'SameSite=None Cookie must have Secure attributes'
+    )
+  })
+
+  it('Should throw for lowercase none without Secure', () => {
+    expect(() => serialize('great_cookie', 'banana', { sameSite: 'none' })).toThrowError(
+      'SameSite=None Cookie must have Secure attributes'
+    )
+  })
+
+  it('Should still serialize SameSite=Lax without Secure', () => {
+    const serialized = serialize('great_cookie', 'banana', { sameSite: 'Lax' })
+    expect(serialized).toBe('great_cookie=banana; SameSite=Lax')
+  })
+})
