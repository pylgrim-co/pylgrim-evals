 export const setCookie = (c: Context, name: string, value: string, opt?: CookieOptions): void => {
   const cookie = generateCookie(name, value, opt)
+  if (cookie.length > 4096) {
+    console.warn(
+      `Cookie "${name}" is ${cookie.length} bytes when serialized, which exceeds the 4096-byte limit and is likely to be silently dropped by browsers`
+    )
+  }
   c.header('Set-Cookie', cookie, { append: true })
 }
 
