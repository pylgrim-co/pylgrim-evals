--- /dev/null
+++ b/src/helper/cookie/coord-oversize-warning.test.ts
@@ -0,0 +1,48 @@
+import { vi } from 'vitest'
+import { Context } from '../../context'
+import { setCookie } from '.'
+
+describe('setCookie oversize warning', () => {
+  const warnSpy = vi.spyOn(console, 'warn').mockImplementation(() => {})
+
+  beforeEach(() => {
+    warnSpy.mockClear()
+  })
+
+  afterAll(() => {
+    warnSpy.mockRestore()
+  })
+
+  it('Should warn once for an oversized cookie and still append the Set-Cookie header', () => {
+    const c = new Context(new Request('http://localhost/'))
+    const bigValue = 'a'.repeat(5000)
+    setCookie(c, 'big_cookie', bigValue)
+
+    expect(warnSpy).toHaveBeenCalledTimes(1)
+    const message = warnSpy.mock.calls[0][0] as string
+    expect(message).toContain('big_cookie')
+    // default path attribute `; Path=/` is part of the serialized string
+    const expectedLength = `big_cookie=${bigValue}; Path=/`.length
+    expect(message).toContain(String(expectedLength))
+
+    const header = c.res.headers.get('Set-Cookie')
+    expect(header).not.toBeNull()
+    expect(header).toContain(`big_cookie=${bigValue}`)
+  })
+
+  it('Should not warn for a normal-size cookie', () => {
+    const c = new Context(new Request('http://localhost/'))
+    setCookie(c, 'small_cookie', 'tasty')
+
+    expect(warnSpy).not.toHaveBeenCalled()
+    expect(c.res.headers.get('Set-Cookie')).toContain('small_cookie=tasty')
+  })
+
+  it('Should warn twice for two oversized setCookie calls', () => {
+    const c = new Context(new Request('http://localhost/'))
+    setCookie(c, 'first_big', 'a'.repeat(5000))
+    setCookie(c, 'second_big', 'b'.repeat(5000))
+
+    expect(warnSpy).toHaveBeenCalledTimes(2)
+  })
+})
