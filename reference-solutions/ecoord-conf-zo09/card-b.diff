--- /dev/null
+++ b/packages/zod/src/v4/classic/tests/coord-fjs-contains.test.ts
@@ -0,0 +1,45 @@
+import { expect, test } from "vitest";
+import { fromJSONSchema } from "../from-json-schema.js";
+
+test("contains requires at least one matching element by default", () => {
+  const schema = fromJSONSchema({
+    type: "array",
+    contains: { type: "number" },
+  });
+  expect(schema.parse(["a", 1])).toEqual(["a", 1]);
+  expect(() => schema.parse(["a", "b"])).toThrow();
+});
+
+test("minContains raises the required count", () => {
+  const schema = fromJSONSchema({
+    type: "array",
+    contains: { type: "number" },
+    minContains: 2,
+  });
+  expect(() => schema.parse(["a", 1])).toThrow();
+  expect(schema.parse(["a", 1, 2])).toEqual(["a", 1, 2]);
+});
+
+test("maxContains caps the count", () => {
+  const schema = fromJSONSchema({
+    type: "array",
+    contains: { type: "number" },
+    maxContains: 1,
+  });
+  expect(schema.parse(["a", 1])).toEqual(["a", 1]);
+  expect(() => schema.parse([1, 2])).toThrow();
+});
+
+test("contains works when items is absent", () => {
+  const schema = fromJSONSchema({
+    type: "array",
+    contains: { type: "string" },
+  });
+  expect(schema.parse([1, "x"])).toEqual([1, "x"]);
+  expect(() => schema.parse([1, 2])).toThrow();
+});
+
+test("without contains untyped arrays still parse anything", () => {
+  const schema = fromJSONSchema({ type: "array" });
+  expect(schema.parse([1, "x", null])).toEqual([1, "x", null]);
+});
