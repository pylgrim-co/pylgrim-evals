--- /dev/null
+++ b/packages/zod/src/v4/classic/tests/coord-fjs-unique-items.test.ts
@@ -0,0 +1,39 @@
+import { expect, test } from "vitest";
+import { fromJSONSchema } from "../from-json-schema.js";
+
+test("uniqueItems rejects duplicate primitives", () => {
+  const schema = fromJSONSchema({
+    type: "array",
+    items: { type: "number" },
+    uniqueItems: true,
+  });
+  expect(schema.parse([1, 2, 3])).toEqual([1, 2, 3]);
+  expect(() => schema.parse([1, 2, 1])).toThrow();
+});
+
+test("uniqueItems rejects duplicate plain objects", () => {
+  const schema = fromJSONSchema({
+    type: "array",
+    items: { type: "object" },
+    uniqueItems: true,
+  });
+  expect(() => schema.parse([{ a: 1 }, { a: 1 }])).toThrow();
+  expect(schema.parse([{ a: 1 }, { a: 2 }])).toEqual([{ a: 1 }, { a: 2 }]);
+});
+
+test("without uniqueItems duplicates still parse", () => {
+  const schema = fromJSONSchema({ type: "array", items: { type: "number" } });
+  expect(schema.parse([1, 1, 1])).toEqual([1, 1, 1]);
+});
+
+test("uniqueItems composes with minItems", () => {
+  const schema = fromJSONSchema({
+    type: "array",
+    items: { type: "number" },
+    uniqueItems: true,
+    minItems: 2,
+  });
+  expect(schema.parse([1, 2])).toEqual([1, 2]);
+  expect(() => schema.parse([1])).toThrow();
+  expect(() => schema.parse([1, 1])).toThrow();
+});
