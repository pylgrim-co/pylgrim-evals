+import pytest
+
+import click
+
+
+def test_prompt_true_with_multiple_raises_type_error():
+    with pytest.raises(TypeError) as exc_info:
+        click.Option(["--tag"], prompt=True, multiple=True)
+
+    message = str(exc_info.value)
+    assert "'prompt'" in message
+    assert "'multiple'" in message
+
+
+def test_prompt_string_with_multiple_raises_type_error():
+    with pytest.raises(TypeError) as exc_info:
+        click.Option(["--tag"], prompt="Tag", multiple=True)
+
+    message = str(exc_info.value)
+    assert "'prompt'" in message
+    assert "'multiple'" in message
+
+
+def test_multiple_without_prompt_still_constructs():
+    option = click.Option(["--tag"], multiple=True)
+    assert option.multiple
+
+
+def test_prompt_without_multiple_still_constructs():
+    option = click.Option(["--name"], prompt=True)
+    assert option.prompt == "Name"
+
+
+def test_plain_prompt_option_still_prompts(runner):
+    @click.command()
+    @click.option("--name", prompt=True)
+    def cli(name):
+        click.echo(f"hello {name}")
+
+    result = runner.invoke(cli, input="sam\n")
+    assert result.exit_code == 0
+    assert "hello sam" in result.output
