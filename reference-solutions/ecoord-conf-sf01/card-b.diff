--- /dev/null
+++ b/test/coord-postgresql-pg16-functions.test.ts
@@ -0,0 +1,61 @@
+import dedent from 'dedent-js';
+
+import { format as originalFormat, FormatFn } from '../src/sqlFormatter.js';
+
+describe('postgresql PostgreSQL 16 built-in functions', () => {
+  const format: FormatFn = (query, cfg = {}) =>
+    originalFormat(query, { ...cfg, language: 'postgresql' });
+
+  it('uppercases any_value, to_bin, erf and random_normal with functionCase: "upper"', () => {
+    const result = format(
+      'SELECT any_value(x), to_bin(n), erf(y), random_normal(0, 1) FROM tbl',
+      { functionCase: 'upper' }
+    );
+    expect(result).toBe(dedent`
+      SELECT
+        ANY_VALUE(x),
+        TO_BIN(n),
+        ERF(y),
+        RANDOM_NORMAL(0, 1)
+      FROM
+        tbl
+    `);
+  });
+
+  it('lowercases TO_OCT and ERFC with functionCase: "lower"', () => {
+    const result = format('SELECT TO_OCT(n), ERFC(y) FROM tbl', {
+      functionCase: 'lower',
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        to_oct(n),
+        erfc(y)
+      FROM
+        tbl
+    `);
+  });
+
+  it('preserves mixed-case spellings of the new functions by default', () => {
+    const result = format('SELECT Any_Value(x), To_Bin(n) FROM tbl');
+    expect(result).toBe(dedent`
+      SELECT
+        Any_Value(x),
+        To_Bin(n)
+      FROM
+        tbl
+    `);
+  });
+
+  it('does not uppercase unknown function names with functionCase: "upper"', () => {
+    const result = format('SELECT my_custom_fn(x), erf(y) FROM tbl', {
+      functionCase: 'upper',
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        my_custom_fn(x),
+        ERF(y)
+      FROM
+        tbl
+    `);
+  });
+});
