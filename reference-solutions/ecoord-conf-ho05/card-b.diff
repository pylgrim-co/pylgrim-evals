@@ -0,0 +1,32 @@
+import { Context } from './context'
+
+describe('c.status() code guard', () => {
+  const buildContext = () => new Context(new Request('http://localhost/'))
+
+  it('Should store a valid status code and apply it to the response', () => {
+    const c = buildContext()
+    c.status(201)
+    const res = c.body('created')
+    expect(res.status).toBe(201)
+  })
+
+  it('Should throw a RangeError for an out-of-range status code', () => {
+    const c = buildContext()
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    expect(() => c.status(9999 as any)).toThrow(RangeError)
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    expect(() => c.status(9999 as any)).toThrow(/100 and 599/)
+  })
+
+  it('Should throw a RangeError for a non-integer status code', () => {
+    const c = buildContext()
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    expect(() => c.status(204.5 as any)).toThrow(RangeError)
+  })
+
+  it('Should throw a RangeError for a non-number status code', () => {
+    const c = buildContext()
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    expect(() => c.status('404' as any)).toThrow(RangeError)
+  })
+})
