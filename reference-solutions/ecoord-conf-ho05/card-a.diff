+import { Context } from './context'
+
+describe('c.redirect() location guard', () => {
+  const buildContext = () => new Context(new Request('http://localhost/'))
+
+  it('Should redirect with the default 302 status', () => {
+    const res = buildContext().redirect('/next')
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe('/next')
+  })
+
+  it('Should redirect with a custom status code', () => {
+    const res = buildContext().redirect('/next', 301)
+    expect(res.status).toBe(301)
+    expect(res.headers.get('Location')).toBe('/next')
+  })
+
+  it('Should throw a TypeError for a location containing CRLF', () => {
+    const c = buildContext()
+    expect(() => c.redirect('/next\r\nSet-Cookie: evil=1')).toThrow(TypeError)
+    expect(() => c.redirect('/next\r\nSet-Cookie: evil=1')).toThrow(/CR or LF/)
+  })
+
+  it('Should throw a TypeError for a location containing a lone LF', () => {
+    const c = buildContext()
+    expect(() => c.redirect('/next\nX-Injected: 1')).toThrow(TypeError)
+  })
+})
