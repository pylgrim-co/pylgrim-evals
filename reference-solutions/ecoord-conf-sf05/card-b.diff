@@ -0,0 +1,33 @@
+import { formatDialect, sqlite, ConfigError, DialectOptions } from '../src/index.js';
+
+describe('formatDialect dialect argument validation', () => {
+  it('throws ConfigError suggesting format() with the language option for a string dialect', () => {
+    const callWithString = () => {
+      formatDialect('SELECT 1', { dialect: 'sqlite' as unknown as DialectOptions });
+    };
+    expect(callWithString).toThrow(ConfigError);
+    expect(callWithString).toThrow(/format\(\).*language/);
+  });
+
+  it('throws ConfigError naming what was received when dialect is undefined', () => {
+    const callWithUndefined = () => {
+      formatDialect('SELECT 1', { dialect: undefined as unknown as DialectOptions });
+    };
+    expect(callWithUndefined).toThrow(ConfigError);
+    expect(callWithUndefined).toThrow('undefined');
+  });
+
+  it('throws ConfigError naming the missing property for an empty object dialect', () => {
+    const callWithEmptyObject = () => {
+      formatDialect('SELECT 1', { dialect: {} as DialectOptions });
+    };
+    expect(callWithEmptyObject).toThrow(ConfigError);
+    expect(callWithEmptyObject).toThrow('name');
+  });
+
+  it('still formats a simple SELECT with the real sqlite DialectOptions object', () => {
+    expect(formatDialect('SELECT * FROM tbl', { dialect: sqlite })).toBe(
+      'SELECT\n  *\nFROM\n  tbl'
+    );
+  });
+});
