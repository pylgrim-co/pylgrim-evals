+++ b/tests/test_coord_completion_item_eq.py
@@ -0,0 +1,33 @@
+from click.shell_completion import CompletionItem
+
+
+def test_equal_items():
+    a = CompletionItem("x", type="file", help="h")
+    b = CompletionItem("x", type="file", help="h")
+    assert a == b
+    assert hash(a) == hash(b)
+
+
+def test_unequal_per_field():
+    base = CompletionItem("x", type="file", help="h")
+    assert base != CompletionItem("y", type="file", help="h")
+    assert base != CompletionItem("x", type="dir", help="h")
+    assert base != CompletionItem("x", type="file", help="other")
+
+
+def test_extra_kwargs_do_not_affect_equality():
+    a = CompletionItem("x", flavor="spicy")
+    b = CompletionItem("x", flavor="mild")
+    assert a == b
+
+
+def test_foreign_type_comparison():
+    item = CompletionItem("x")
+    assert item.__eq__("x") is NotImplemented
+    assert (item == "x") is False
+    assert (item != "x") is True
+
+
+def test_set_collapses_duplicates():
+    items = {CompletionItem("x"), CompletionItem("x"), CompletionItem("y")}
+    assert len(items) == 2
