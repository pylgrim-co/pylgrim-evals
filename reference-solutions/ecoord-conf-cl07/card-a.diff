+++ b/tests/test_coord_completion_item_repr.py
@@ -0,0 +1,25 @@
+from click.shell_completion import CompletionItem
+
+
+def test_repr_with_defaults():
+    item = CompletionItem("file.txt")
+    assert repr(item) == "CompletionItem('file.txt', type='plain', help=None)"
+
+
+def test_repr_with_explicit_type_and_help():
+    item = CompletionItem("docs", type="dir", help="a directory")
+    assert repr(item) == "CompletionItem('docs', type='dir', help='a directory')"
+
+
+def test_repr_ignores_extra_kwargs():
+    item = CompletionItem("x", flavor="spicy")
+    assert "flavor" not in repr(item)
+    assert repr(item) == "CompletionItem('x', type='plain', help=None)"
+
+
+def test_list_printing_shows_reprs():
+    items = [CompletionItem("a"), CompletionItem("b")]
+    assert str(items) == (
+        "[CompletionItem('a', type='plain', help=None),"
+        " CompletionItem('b', type='plain', help=None)]"
+    )
