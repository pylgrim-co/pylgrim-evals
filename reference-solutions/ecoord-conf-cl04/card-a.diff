@@ -0,0 +1,41 @@
+import pytest
+
+import click.utils
+from click.exceptions import FileError
+from click.utils import LazyFile
+
+
+def test_oserror_without_strerror_reports_str(monkeypatch):
+    def raise_bare_oserror(*args, **kwargs):
+        raise OSError("disk quota exceeded")
+
+    monkeypatch.setattr(click.utils, "open_stream", raise_bare_oserror)
+
+    with pytest.raises(FileError) as exc_info:
+        LazyFile("x.txt", "w").open()
+
+    message = exc_info.value.format_message()
+    assert "disk quota exceeded" in message
+    assert "unknown error" not in message
+
+
+def test_oserror_with_strerror_is_unchanged(monkeypatch):
+    def raise_full_oserror(*args, **kwargs):
+        raise OSError(13, "Permission denied")
+
+    monkeypatch.setattr(click.utils, "open_stream", raise_full_oserror)
+
+    with pytest.raises(FileError) as exc_info:
+        LazyFile("x.txt", "w").open()
+
+    assert "Permission denied" in exc_info.value.format_message()
+
+
+def test_unpatched_happy_path_still_writes(tmp_path):
+    path = tmp_path / "out.txt"
+    lazy_file = LazyFile(str(path), "w")
+    f = lazy_file.open()
+    f.write("hello")
+    lazy_file.close()
+
+    assert path.read_text() == "hello"
