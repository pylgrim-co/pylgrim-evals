diff --git a/packages/zod/src/v4/classic/tests/coord-check-capitalize.test.ts b/packages/zod/src/v4/classic/tests/coord-check-capitalize.test.ts
new file mode 100644
index 00000000..ab31fba9
--- /dev/null
+++ b/packages/zod/src/v4/classic/tests/coord-check-capitalize.test.ts
@@ -0,0 +1,27 @@
+import { expect, test } from "vitest";
+
+import * as z from "zod/v4";
+
+test("capitalize uppercases the first character and leaves the rest untouched", () => {
+  expect(z.string().check(z.capitalize()).parse("hello world")).toBe("Hello world");
+});
+
+test("an already-capitalized input is unchanged", () => {
+  expect(z.string().check(z.capitalize()).parse("Hello world")).toBe("Hello world");
+});
+
+test("the empty string stays empty", () => {
+  expect(z.string().check(z.capitalize()).parse("")).toBe("");
+});
+
+test("a single character is uppercased", () => {
+  expect(z.string().check(z.capitalize()).parse("a")).toBe("A");
+});
+
+test("a first character with no uppercase form is left as is", () => {
+  expect(z.string().check(z.capitalize()).parse("1abc")).toBe("1abc");
+});
+
+test("capitalize composes after trim in the same check call", () => {
+  expect(z.string().check(z.trim(), z.capitalize()).parse("  hello")).toBe("Hello");
+});
diff --git a/packages/zod/src/v4/core/api.ts b/packages/zod/src/v4/core/api.ts
