diff --git a/packages/zod/src/v4/classic/tests/coord-check-truncate.test.ts b/packages/zod/src/v4/classic/tests/coord-check-truncate.test.ts
new file mode 100644
index 00000000..5b743bec
--- /dev/null
+++ b/packages/zod/src/v4/classic/tests/coord-check-truncate.test.ts
@@ -0,0 +1,26 @@
+import { expect, test } from "vitest";
+
+import * as z from "zod/v4";
+
+test("truncate caps strings longer than maxLength", () => {
+  expect(z.string().check(z.truncate(5)).parse("hello world")).toBe("hello");
+});
+
+test("a string shorter than the cap is unchanged", () => {
+  expect(z.string().check(z.truncate(5)).parse("hi")).toBe("hi");
+  expect(z.string().check(z.truncate(5)).parse("hello")).toBe("hello");
+});
+
+test("truncate(0) maps any string to the empty string", () => {
+  expect(z.string().check(z.truncate(0)).parse("hello")).toBe("");
+  expect(z.string().check(z.truncate(0)).parse("")).toBe("");
+});
+
+test("an invalid maxLength throws TypeError at construction", () => {
+  expect(() => z.truncate(2.5 as any)).toThrow(TypeError);
+  expect(() => z.truncate(-1)).toThrow(TypeError);
+});
+
+test("truncate composes after trim in the same check call", () => {
+  expect(z.string().check(z.trim(), z.truncate(5)).parse("  hello world")).toBe("hello");
+});
