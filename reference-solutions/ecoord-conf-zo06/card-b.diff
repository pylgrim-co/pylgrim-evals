@@ -1153,6 +1153,14 @@ export function _toUpperCase(): checks.$ZodCheckOverwrite<string> {
 export function _slugify(): checks.$ZodCheckOverwrite<string> {
   return _overwrite((input) => util.slugify(input));
 }
+// truncate
+// @__NO_SIDE_EFFECTS__
+export function _truncate(maxLength: number): checks.$ZodCheckOverwrite<string> {
+  if (!Number.isInteger(maxLength) || maxLength < 0) {
+    throw new TypeError(`truncate: maxLength must be a non-negative integer, received ${maxLength}`);
+  }
+  return _overwrite((input) => (input.length <= maxLength ? input : input.slice(0, maxLength)));
+}
 
