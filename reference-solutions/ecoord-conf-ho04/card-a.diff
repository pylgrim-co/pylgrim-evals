@@ -0,0 +1,45 @@
+import { Hono } from '../../hono'
+import { basicAuth } from '.'
+
+describe('Basic Auth charset option', () => {
+  const username = 'hono-user'
+  const password = 'hono-password'
+
+  it('Should include charset="UTF-8" in the challenge when configured', async () => {
+    const app = new Hono()
+    app.use('/auth/*', basicAuth({ username, password, charset: 'UTF-8' }))
+    app.get('/auth/page', (c) => c.text('secret'))
+
+    const res = await app.request('/auth/page')
+    expect(res.status).toBe(401)
+    const header = res.headers.get('WWW-Authenticate')
+    expect(header).not.toBeNull()
+    expect(header).toContain('realm="Secure Area"')
+    expect(header).toContain('charset="UTF-8"')
+  })
+
+  it('Should not include a charset auth-param when the option is absent', async () => {
+    const app = new Hono()
+    app.use('/auth/*', basicAuth({ username, password }))
+    app.get('/auth/page', (c) => c.text('secret'))
+
+    const res = await app.request('/auth/page')
+    expect(res.status).toBe(401)
+    const header = res.headers.get('WWW-Authenticate')
+    expect(header).toBe('Basic realm="Secure Area"')
+    expect(header).not.toContain('charset')
+  })
+
+  it('Should still authenticate valid credentials when charset is configured', async () => {
+    const app = new Hono()
+    app.use('/auth/*', basicAuth({ username, password, charset: 'UTF-8' }))
+    app.get('/auth/page', (c) => c.text('secret'))
+
+    const credential = Buffer.from(`${username}:${password}`).toString('base64')
+    const res = await app.request('/auth/page', {
+      headers: { Authorization: `Basic ${credential}` },
+    })
+    expect(res.status).toBe(200)
+    expect(await res.text()).toBe('secret')
+  })
+})
