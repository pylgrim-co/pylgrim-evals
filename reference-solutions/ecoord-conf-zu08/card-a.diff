diff --git a/tests/coord/immer-noop-warn.test.ts b/tests/coord/immer-noop-warn.test.ts
new file mode 100644
index 0000000..6508448
--- /dev/null
+++ b/tests/coord/immer-noop-warn.test.ts
@@ -0,0 +1,51 @@
+import { afterEach, expect, it, vi } from 'vitest'
+import { immer } from 'zustand/middleware/immer'
+import { createStore } from 'zustand/vanilla'
+
+type State = { count: number }
+
+afterEach(() => {
+  vi.restoreAllMocks()
+})
+
+it('a draft-mutating updater updates state and does not warn', () => {
+  const warn = vi.spyOn(console, 'warn').mockImplementation(() => {})
+  const store = createStore(
+    immer<State>(() => ({ count: 0 }), { warnOnNoop: true }),
+  )
+  store.setState((draft) => {
+    draft.count += 1
+  })
+  expect(store.getState().count).toBe(1)
+  expect(warn).not.toHaveBeenCalled()
+})
+
+it('an updater that touches nothing warns once and keeps the state reference', () => {
+  const warn = vi.spyOn(console, 'warn').mockImplementation(() => {})
+  const store = createStore(
+    immer<State>(() => ({ count: 0 }), { warnOnNoop: true }),
+  )
+  const before = store.getState()
+  store.setState(() => {})
+  expect(warn).toHaveBeenCalledTimes(1)
+  expect(String(warn.mock.calls[0]?.[0])).toContain('no changes')
+  expect(store.getState()).toBe(before)
+})
+
+it('a plain-object setState never warns', () => {
+  const warn = vi.spyOn(console, 'warn').mockImplementation(() => {})
+  const store = createStore(
+    immer<State>(() => ({ count: 0 }), { warnOnNoop: true }),
+  )
+  store.setState({ count: 5 })
+  expect(store.getState().count).toBe(5)
+  expect(warn).not.toHaveBeenCalled()
+})
+
+it('without options an empty updater does not warn', () => {
+  const warn = vi.spyOn(console, 'warn').mockImplementation(() => {})
+  const store = createStore(immer<State>(() => ({ count: 0 })))
+  store.setState(() => {})
+  expect(store.getState().count).toBe(0)
+  expect(warn).not.toHaveBeenCalled()
+})
