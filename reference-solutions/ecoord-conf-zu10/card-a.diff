index 0000000..33b2f52
--- /dev/null
+++ b/tests/coord/use-store-arg-guard.test.tsx
@@ -0,0 +1,51 @@
+import { render, screen } from '@testing-library/react'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { useStore } from 'zustand'
+import { createStore } from 'zustand/vanilla'
+
+const consoleError = console.error
+
+beforeEach(() => {
+  console.error = vi.fn()
+})
+
+afterEach(() => {
+  console.error = consoleError
+})
+
+it('throws TypeError when the first argument is not a store api', () => {
+  const Component = () => {
+    useStore({} as any)
+    return null
+  }
+  expect(() => render(<Component />)).toThrow(TypeError)
+})
+
+it('throws TypeError when the selector is not a function', () => {
+  const store = createStore(() => ({ count: 0 }))
+  const Component = () => {
+    useStore(store, 42 as any)
+    return null
+  }
+  expect(() => render(<Component />)).toThrow(TypeError)
+})
+
+it('renders the selected slice for a valid store and selector', async () => {
+  const store = createStore(() => ({ count: 7 }))
+  const Component = () => {
+    const count = useStore(store, (s) => s.count)
+    return <div>count: {count}</div>
+  }
+  render(<Component />)
+  expect(await screen.findByText('count: 7')).toBeDefined()
+})
+
+it('renders the whole state without a selector', async () => {
+  const store = createStore(() => ({ label: 'whole' }))
+  const Component = () => {
+    const state = useStore(store)
+    return <div>label: {state.label}</div>
+  }
+  render(<Component />)
+  expect(await screen.findByText('label: whole')).toBeDefined()
+})
