diff --git a/tests/coord/create-arg-guard.test.ts b/tests/coord/create-arg-guard.test.ts
new file mode 100644
index 0000000..0683802
--- /dev/null
+++ b/tests/coord/create-arg-guard.test.ts
@@ -0,0 +1,26 @@
+import { expect, it } from 'vitest'
+import { create } from 'zustand'
+
+it('throws TypeError for a number, string, or null initializer', () => {
+  expect(() => create(42 as any)).toThrow(TypeError)
+  expect(() => create('x' as any)).toThrow(TypeError)
+  expect(() => create(null as any)).toThrow(TypeError)
+})
+
+it('throws TypeError on the curried path for defined non-function values', () => {
+  expect(() => create()(42 as any)).toThrow(TypeError)
+})
+
+it('returns the curried function when called with no argument', () => {
+  const curried = create()
+  expect(typeof curried).toBe('function')
+  const useBoundStore = curried(() => ({ ready: true }))
+  expect(useBoundStore.getState().ready).toBe(true)
+})
+
+it('creates a working bound store for a valid initializer', () => {
+  const useBoundStore = create(() => ({ count: 3 }))
+  expect(useBoundStore.getState().count).toBe(3)
+  useBoundStore.setState({ count: 4 })
+  expect(useBoundStore.getState().count).toBe(4)
+})
