diff --git a/tests/test_coord_force_color_env.py b/tests/test_coord_force_color_env.py
new file mode 100644
index 0000000..4ce1613
--- /dev/null
+++ b/tests/test_coord_force_color_env.py
@@ -0,0 +1,38 @@
+import io
+
+import click
+
+STYLED = click.style("hello", fg="green")
+
+
+def test_force_color_keeps_codes_on_non_tty(monkeypatch):
+    monkeypatch.setenv("FORCE_COLOR", "1")
+    out = io.StringIO()
+    click.echo(STYLED, file=out)
+    assert out.getvalue() == f"{STYLED}
+"
+    assert "[" in out.getvalue()
+
+
+def test_without_force_color_non_tty_strips(monkeypatch):
+    monkeypatch.delenv("FORCE_COLOR", raising=False)
+    out = io.StringIO()
+    click.echo(STYLED, file=out)
+    assert out.getvalue() == "hello
+"
+
+
+def test_empty_force_color_behaves_as_unset(monkeypatch):
+    monkeypatch.setenv("FORCE_COLOR", "")
+    out = io.StringIO()
+    click.echo(STYLED, file=out)
+    assert out.getvalue() == "hello
+"
+
+
+def test_explicit_color_false_wins(monkeypatch):
+    monkeypatch.setenv("FORCE_COLOR", "1")
+    out = io.StringIO()
+    click.echo(STYLED, file=out, color=False)
+    assert out.getvalue() == "hello
+"
