+++ b/tests/test_coord_no_color_env.py
@@ -0,0 +1,42 @@
+import io
+
+import click
+
+
+class TtyStringIO(io.StringIO):
+    def isatty(self) -> bool:
+        return True
+
+
+STYLED = click.style("hello", fg="green")
+
+
+def test_no_color_strips_on_tty(monkeypatch):
+    monkeypatch.setenv("NO_COLOR", "1")
+    out = TtyStringIO()
+    click.echo(STYLED, file=out)
+    assert out.getvalue() == "hello
+"
+
+
+def test_without_no_color_tty_keeps_codes(monkeypatch):
+    monkeypatch.delenv("NO_COLOR", raising=False)
+    out = TtyStringIO()
+    click.echo(STYLED, file=out)
+    assert out.getvalue() == f"{STYLED}
+"
+    assert "[" in out.getvalue()
+
+
+def test_empty_no_color_behaves_as_unset(monkeypatch):
+    monkeypatch.setenv("NO_COLOR", "")
+    out = TtyStringIO()
+    click.echo(STYLED, file=out)
+    assert "[" in out.getvalue()
+
+
+def test_explicit_color_true_wins(monkeypatch):
+    monkeypatch.setenv("NO_COLOR", "1")
+    out = TtyStringIO()
+    click.echo(STYLED, file=out, color=True)
+    assert "[" in out.getvalue()
