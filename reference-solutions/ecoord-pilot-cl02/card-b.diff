diff --git a/tests/test_coord_prompt_attempts.py b/tests/test_coord_prompt_attempts.py
new file mode 100644
index 0000000..4dc8cec
--- /dev/null
+++ b/tests/test_coord_prompt_attempts.py
@@ -0,0 +1,35 @@
+import click
+from click.testing import CliRunner
+
+
+def make_cli(max_attempts):
+    @click.command()
+    def cli():
+        value = click.prompt("count", type=click.INT, max_attempts=max_attempts)
+        click.echo(f"got {value}")
+
+    return cli
+
+
+def test_aborts_after_max_attempts():
+    runner = CliRunner()
+    result = runner.invoke(make_cli(2), input="a\nb\n")
+    assert result.exit_code == 1
+    assert result.output.count("Error:") == 2
+    assert "Aborted" in result.output + result.stderr
+
+
+def test_succeeds_within_attempts():
+    runner = CliRunner()
+    result = runner.invoke(make_cli(2), input="a\n5\n")
+    assert result.exit_code == 0
+    assert result.output.count("Error:") == 1
+    assert "got 5" in result.output
+
+
+def test_default_still_retries_past_repeated_failures():
+    runner = CliRunner()
+    result = runner.invoke(make_cli(None), input="a\nb\n7\n")
+    assert result.exit_code == 0
+    assert result.output.count("Error:") == 2
+    assert "got 7" in result.output
