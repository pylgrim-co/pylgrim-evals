diff --git a/tests/test_coord_echo_flush.py b/tests/test_coord_echo_flush.py
new file mode 100644
index 0000000..32c2056
--- /dev/null
+++ b/tests/test_coord_echo_flush.py
@@ -0,0 +1,49 @@
+import io
+
+import click
+
+
+class FlushRecorder(io.StringIO):
+    def __init__(self):
+        super().__init__()
+        self.flush_count = 0
+
+    def flush(self):
+        self.flush_count += 1
+        super().flush()
+
+
+def test_default_echo_writes_and_flushes():
+    stream = FlushRecorder()
+    click.echo("hello", file=stream)
+    assert stream.getvalue() == "hello\n"
+    assert stream.flush_count == 1
+
+
+def test_flush_false_writes_without_flushing():
+    stream = FlushRecorder()
+    click.echo("hello", file=stream, flush=False)
+    assert stream.getvalue() == "hello\n"
+    assert stream.flush_count == 0
+
+
+def test_flush_false_many_writes_never_flush():
+    stream = FlushRecorder()
+    for i in range(10):
+        click.echo(str(i), file=stream, flush=False)
+    assert stream.getvalue() == "".join(f"{i}\n" for i in range(10))
+    assert stream.flush_count == 0
+
+
+def test_flush_false_empty_message_does_not_flush():
+    stream = FlushRecorder()
+    click.echo(None, file=stream, nl=False, flush=False)
+    assert stream.getvalue() == ""
+    assert stream.flush_count == 0
+
+
+def test_empty_message_default_still_flushes():
+    stream = FlushRecorder()
+    click.echo(None, file=stream, nl=False)
+    assert stream.getvalue() == ""
+    assert stream.flush_count == 1
