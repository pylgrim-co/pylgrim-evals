-export function prettifyError(error: StandardSchemaV1.FailureResult): string {
+export function prettifyError(error: StandardSchemaV1.FailureResult, params?: { maxIssues?: number }): string {
   const lines: string[] = [];
   // sort by path length
   const issues = [...error.issues].sort((a, b) => (a.path ?? []).length - (b.path ?? []).length);
 
+  // cap the number of rendered issues when a valid maxIssues is provided
+  let visibleIssues = issues;
+  let omitted = 0;
+  const maxIssues = params?.maxIssues;
+  if (typeof maxIssues === "number" && Number.isInteger(maxIssues) && maxIssues > 0 && issues.length > maxIssues) {
+    visibleIssues = issues.slice(0, maxIssues);
+    omitted = issues.length - maxIssues;
+  }
+
   // Process each issue
-  for (const issue of issues) {
+  for (const issue of visibleIssues) {
     lines.push(`✖ ${issue.message}`);
     if (issue.path?.length) lines.push(`  → at ${toDotPath(issue.path)}`);
   }
 
+  if (omitted > 0) lines.push(`+${omitted} more`);
+
   // Convert Map to formatted string
   return lines.join("\n");
 }
