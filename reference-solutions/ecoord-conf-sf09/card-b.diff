+import dedent from 'dedent-js';
+
+import { format as originalFormat, FormatFn } from '../src/sqlFormatter.js';
+
+describe('transactsql JSON construction functions', () => {
+  const format: FormatFn = (query, cfg = {}) =>
+    originalFormat(query, { ...cfg, language: 'transactsql' });
+
+  it('uppercases json_object and json_array with functionCase: "upper"', () => {
+    const result = format('SELECT json_object(a), json_array(b) FROM t', {
+      functionCase: 'upper',
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        JSON_OBJECT(a),
+        JSON_ARRAY(b)
+      FROM
+        t
+    `);
+  });
+
+  it('lowercases JSON_PATH_EXISTS with functionCase: "lower"', () => {
+    const result = format("SELECT JSON_PATH_EXISTS(j, '$.a') FROM t", {
+      functionCase: 'lower',
+    });
+    expect(result).toBe(dedent`
+      SELECT
+        json_path_exists(j, '$.a')
+      FROM
+        t
+    `);
+  });
+
+  it('still uppercases the existing isjson function', () => {
+    const result = format('SELECT isjson(j) FROM t', { functionCase: 'upper' });
+    expect(result).toBe(dedent`
+      SELECT
+        ISJSON(j)
+      FROM
+        t
+    `);
+  });
+
+  it('leaves unrelated identifiers untouched by functionCase', () => {
+    const result = format('SELECT my_column FROM t', { functionCase: 'upper' });
+    expect(result).toBe(dedent`
+      SELECT
+        my_column
+      FROM
+        t
+    `);
+  });
+});
