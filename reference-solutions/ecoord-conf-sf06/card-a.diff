@@ -0,0 +1,46 @@
+import dedent from 'dedent-js';
+
+import { format } from '../src/sqlFormatter.js';
+import { ConfigError } from '../src/index.js';
+
+describe('numeric layout option validation', () => {
+  it('throws ConfigError naming tabWidth and the value when tabWidth is negative', () => {
+    expect(() => format('SELECT *', { tabWidth: -2 })).toThrow(ConfigError);
+    expect(() => format('SELECT *', { tabWidth: -2 })).toThrow(
+      'tabWidth config must be a finite non-negative number. Received -2 instead.'
+    );
+  });
+
+  it('throws ConfigError naming linesBetweenQueries when it is negative', () => {
+    expect(() => format('SELECT 1; SELECT 2;', { linesBetweenQueries: -1 })).toThrow(ConfigError);
+    expect(() => format('SELECT 1; SELECT 2;', { linesBetweenQueries: -1 })).toThrow(
+      'linesBetweenQueries'
+    );
+  });
+
+  it('throws ConfigError when tabWidth is NaN', () => {
+    expect(() => format('SELECT *', { tabWidth: NaN })).toThrow(ConfigError);
+  });
+
+  it('throws ConfigError when tabWidth is Infinity', () => {
+    expect(() => format('SELECT *', { tabWidth: Infinity })).toThrow(ConfigError);
+  });
+
+  it('accepts tabWidth 0', () => {
+    expect(format('SELECT one FROM tbl', { tabWidth: 0 })).toBe(dedent`
+      SELECT
+      one
+      FROM
+      tbl
+    `);
+  });
+
+  it('still formats correctly with a normal config', () => {
+    expect(format('SELECT one FROM tbl', { tabWidth: 4 })).toBe(dedent`
+      SELECT
+          one
+      FROM
+          tbl
+    `);
+  });
+});
