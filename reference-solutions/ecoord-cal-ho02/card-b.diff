@@ -0,0 +1,34 @@
+import { HTTPException } from './http-exception'
+
+describe('HTTPException default status-text message', () => {
+  it('defaults message and body to Not Found for 404', async () => {
+    const exception = new HTTPException(404)
+    expect(exception.message).toBe('Not Found')
+    const res = exception.getResponse()
+    expect(res.status).toBe(404)
+    expect(await res.text()).toBe('Not Found')
+  })
+
+  it('defaults other mapped codes to their reason phrases', () => {
+    expect(new HTTPException(401).message).toBe('Unauthorized')
+    expect(new HTTPException(429).message).toBe('Too Many Requests')
+    expect(new HTTPException(503).message).toBe('Service Unavailable')
+  })
+
+  it('lets an explicit message win over the default', async () => {
+    const exception = new HTTPException(404, { message: 'missing thing' })
+    expect(exception.message).toBe('missing thing')
+    expect(await exception.getResponse().text()).toBe('missing thing')
+  })
+
+  it('keeps an empty message for statuses outside the map', () => {
+    expect(new HTTPException(418).message).toBe('')
+  })
+
+  it('still lets a provided res control the body', async () => {
+    const exception = new HTTPException(400, {
+      res: new Response('custom body', { status: 200 }),
+    })
+    expect(await exception.getResponse().text()).toBe('custom body')
+  })
+})
