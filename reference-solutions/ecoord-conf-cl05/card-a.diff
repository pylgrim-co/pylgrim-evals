diff --git a/tests/test_coord_style_hex.py b/tests/test_coord_style_hex.py
new file mode 100644
index 0000000..4012a4f
--- /dev/null
+++ b/tests/test_coord_style_hex.py
@@ -0,0 +1,25 @@
+import pytest
+
+import click
+
+
+def test_hex_fg_equals_rgb_tuple():
+    assert click.style("x", fg="#ff0000") == click.style("x", fg=(255, 0, 0))
+
+
+def test_uppercase_hex_is_accepted():
+    assert click.style("x", fg="#00FF7F") == click.style("x", fg=(0, 255, 127))
+
+
+def test_hex_bg_emits_background_escape():
+    assert click.style("x", bg="#0000ff") == "\x1b[48;2;0;0;255mx\x1b[0m"
+
+
+@pytest.mark.parametrize("color", ["#12345", "#zzzzzz"])
+def test_malformed_hex_raises_type_error(color):
+    with pytest.raises(TypeError, match="Unknown color"):
+        click.style("x", fg=color)
+
+
+def test_named_color_output_is_unchanged():
+    assert click.style("x", fg="red") == "\x1b[31mx\x1b[0m"
