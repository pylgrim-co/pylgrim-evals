diff --git a/tests/test_coord_confirm_bool_words.py b/tests/test_coord_confirm_bool_words.py
new file mode 100644
index 0000000..3c0cd6d
--- /dev/null
+++ b/tests/test_coord_confirm_bool_words.py
@@ -0,0 +1,51 @@
+import pytest
+
+import click
+
+
+@click.command()
+def cli():
+    if click.confirm("Continue?"):
+        click.echo("CONFIRMED")
+    else:
+        click.echo("DECLINED")
+
+
+@pytest.mark.parametrize("answer", ["t", "true", "1", "on"])
+def test_bool_truthy_words_are_accepted(runner, answer):
+    result = runner.invoke(cli, input=f"{answer}\n")
+    assert result.exit_code == 0
+    assert "CONFIRMED" in result.output
+
+
+@pytest.mark.parametrize("answer", ["f", "false", "0", "off"])
+def test_bool_falsy_words_are_accepted(runner, answer):
+    result = runner.invoke(cli, input=f"{answer}\n")
+    assert result.exit_code == 0
+    assert "DECLINED" in result.output
+
+
+def test_unrecognized_answer_still_retries(runner):
+    result = runner.invoke(cli, input="maybe\ny\n")
+    assert result.exit_code == 0
+    assert "Error: invalid input" in result.output
+    assert "CONFIRMED" in result.output
+
+
+def test_empty_input_still_uses_default(runner):
+    @click.command()
+    def cli_with_default():
+        if click.confirm("Continue?", default=True):
+            click.echo("CONFIRMED")
+        else:
+            click.echo("DECLINED")
+
+    result = runner.invoke(cli_with_default, input="\n")
+    assert result.exit_code == 0
+    assert "CONFIRMED" in result.output
+
+
+def test_legacy_n_still_declines(runner):
+    result = runner.invoke(cli, input="n\n")
+    assert result.exit_code == 0
+    assert "DECLINED" in result.output
